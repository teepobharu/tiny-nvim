{
  "Agoda Test Case Scaffold": {
    "prefix": "agtc",
    "body": [
      "// Usage notes:",
      "// source: ~/dotfiles/.config/nvim3_jelly_tinynvim/snippets/web/coding-exercise.json",
      "// - Put your solution logic in the function below.",
      "// - Add cases to testCases; input is spread into your function.",
      "// - Run in Node/Bun/Browser console; no env-specific helpers required.",
      "",
      "function main() {",
      "  return testSolution(${1:solutionName});",
      "  // return testSolution(sol2);",
      "  // return testSolution(bruteForce);",
      "  // return testSolution(optimized);",
      "}",
      "",
      "function ${1:solutionName}(${2:input}) {",
      "  ${0}",
      "}",
      "",
      "const testCases = [",
      "  {",
      "    \"case\": \"${3:basic case}\",",
      "    \"input\": [${4}],",
      "    \"output\": ${5:[]}",
      "  },",
      "];",
      "",
      "function testSolution(cb) {",
      "  const fnName = cb.name;",
      "  console.log(`\\n🧪 Testing: \\${fnName}\\n---------------------\\n`);",
      "",
      "  let passed = 0;",
      "  let failed = 0;",
      "",
      "  for (let i = 0; i < testCases.length; i++) {",
      "    const { case: caseName, input, output } = testCases[i];",
      "    const caseNo = i + 1;",
      "    const caseLabel = `\\${caseNo}. \\${caseName || 'unnamed'}`;",
      "",
      "    try {",
      "      const args = Array.isArray(input) ? input : [input];",
      "      const result = cb(...args);",
      "      console.assert(",
      "        JSON.stringify(result) === JSON.stringify(output),",
      "        `Expected: \\${JSON.stringify(output)}, Got: \\${JSON.stringify(result)}`",
      "      );",
      "      passed++;",
      "      console.log(`✅ \\${caseLabel}`, { input });",
      "    } catch (e) {",
      "      failed++;",
      "      console.error('❌ ' + caseLabel, {",
      "        input,",
      "        expected: output,",
      "        error: e,",
      "      });",
      "    }",
      "  }",
      "",
      "  const total = passed + failed;",
      "  const ok = failed === 0;",
      "  const summary = ok",
      "    ? `\\${passed}/\\${total} passed ✅`",
      "    : `\\${passed}/\\${total} passed ❌ (\\${failed} failed)`;",
      "  console.log(`\\n📝 Summary: \\${summary}\\n`);",
      "}",
      "main();"
    ],
    "description": "Simple JS/TS coding exercise scaffold with test cases and assertions"
  }
}
