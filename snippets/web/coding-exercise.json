{
  "Agoda Test Case Scaffold": {
    "prefix": "agtc",
    "body": [
      "function main() {",
      "  return testSolution(${1:solutionName});",
      "  // return testSolution(sol2);",
      "}",
      "",
      "function ${1:solutionName}(${2:input}) {",
      "  ${0}",
      "}",
      "",
      "function testSolution(cb) {",
      "  const fnName = cb.name;",
      "  console.log(`\\\\nTesting: \\${fnName}\\\\n`);",
      "  ",
      "  const testCases = [",
      "    {",
      "      case: '${3:basic case}',",
      "      input: ${4:[]},",
      "      output: ${5:[]},",
      "    },",
      "  ];",
      "",
      "  for (const { case: caseName, input, output } of testCases) {",
      "    const start = performance.now();",
      "    const result = cb(input);",
      "    const elapsed = (performance.now() - start).toFixed(3);",
      "    ",
      "    try {",
      "      console.assert(",
      "        JSON.stringify(result) === JSON.stringify(output),",
      "        `Expected: \\${JSON.stringify(output)}, Got: \\${JSON.stringify(result)}`",
      "      );",
      "      console.log(`✅ \\${caseName || 'unnamed'} - \\${elapsed}ms`, { input });",
      "    } catch (e) {",
      "      console.error(`❌ \\${caseName || 'unnamed'} - \\${elapsed}ms`, {",
      "        input,",
      "        expected: output,",
      "        got: result,",
      "      });",
      "    }",
      "  }",
      "}",
      "",
      "main();"
    ],
    "description": "Scaffold JS/TS coding exercise with test cases, timing, and assertions"
  }
}
