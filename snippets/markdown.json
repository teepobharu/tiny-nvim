{
  "ImgWithsize": {
    "prefix": "imgsize",
    "body": [
      "<img src=\"${1:path}\" alt=\"${2:alt text}\" width=\"${3:width}\" height=\"${4:height}\"> ${0}"
    ],
    "description": "Add images with size"
  },
  "LinkFromSelection": {
    "prefix": [
      "mdlink",
      "linksel",
      "linkw",
      "wlink"
    ],
    "body": [
      "[${1:text}](${TM_SELECTED_TEXT}$0)"
    ],
    "description": "Create a markdown link using the selected URL"
  },
  "WrapBacktick": {
    "prefix": [
      "bt",
      "qb",
      "code"
    ],
    "body": [
      "`${TM_SELECTED_TEXT}$0`"
    ],
    "description": "Wrap selection in single backticks (inline code)"
  },
  "WrapLinkAlias": {
    "prefix": "walink",
    "body": [
      "[${TM_SELECTED_TEXT:${1:text}}]($2)$0"
    ],
    "description": "Wrap selection as hyperlink alias, enter URL manually"
  },
  "WrapLinkAliasClipboard": {
    "prefix": "walinkc",
    "body": [
      "[${TM_SELECTED_TEXT:${1:text}}](${CLIPBOARD})$0"
    ],
    "description": "Wrap selection as hyperlink alias, URL from clipboard"
  },
  "Frontmatter": {
    "prefix": "fmter",
    "body": [
      "---",
      "$0",
      "---"
    ],
    "description": "Insert YAML frontmatter block with cursor inside"
  },
  "_testcycle": {
    "prefix": "_luasniptestcycle",
    "body": [
      "---",
      "${1|true,false,fee|}",
      "---"
    ],
    "description": "Insert YAML frontmatter block with cursor inside"
  },
  "CodeCompanionPromptFrontmatter": {
    "prefix": "fmterccomp",
    "body": [
      "---",
      "name: ${1:My Prompt Name}",
      "interaction: ${2|chat,inline,cmd|}",
      "description: ${3:Short action-palette description}",
      "",
      "# Add read_file when the prompt refers to files the model should inspect.",
      "# Other common entries: run_command, file_search, grep_search, web_search, memory.",
      "# https://codecompanion.olimorris.dev/configuration/prompt-library#basic-structure",
      "tools: [read_file]",
      "",
      "# Optional: attach specific MCP servers, or set to none to avoid auto-attach.",
      "# mcp_servers:",
      "#   - slack",
      "#   - atlassian",
      "# mcp_servers: none",
      "",
      "# Optional: attach fixed files or URLs before the prompt runs.",
      "# context:",
      "#   - type: file",
      "#     path: ${4:/absolute/path/to/file.md}",
      "#   - type: url",
      "#     url: ${5:https://example.com/docs}",
      "",
      "# Optional: load CodeCompanion rules from config.rules.",
      "# rules: default",
      "# rules: none",
      "",
      "opts:",
      "  enabled: ${6|true,false|}",
      "  is_slash_cmd: ${7|true,false|}",
      "  alias: ${8:my-prompt}",
      "  auto_submit: ${9|false,true|}",
      "  stop_context_insertion: ${10|true,false|}",
      "  # user_prompt: ${11:false}",
      "  # ignore_system_prompt: false",
      "  # adapter:",
      "  #   name: ${12:copilot}",
      "  #   model: ${13:gpt-4.1}",
      "  # index: ${14:10}",
      "---",
      "",
      "## system",
      "",
      "${15:Optional system instructions.}",
      "",
      "## user",
      "",
      "${16:Write the user prompt here.}",
      "",
      "$0"
    ],
    "description": "CodeCompanion markdown prompt scaffold with mature frontmatter fields"
  }
}
