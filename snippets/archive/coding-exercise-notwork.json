{
  "Agoda Test Case Scaffold": {
    "prefix": "agtc",
    "body": [
      "function main() {",
      "  return testSolution(${1:solutionName});",
      "  // return testSolution(sol2);",
      "}",
      "",
      "function ${1:solutionName}(${2:input}) {",
      "  ${0}",
      "}",
      "",
      "const DEFAULT_TIMEOUT = ${6:1000};",
      "const testCases = [",
      "  {",
      "    \"case\": \"${3:basic case}\",",
      "    \"input\": [${4}],",
      "    \"output\": ${5:[]},",
      "    // optional per-case override: timeout: 500",
      "  },",
      "];",
      "",
      "async function runWithTimeout(userFnOrCode, timeoutMs, ...args) {",
      "  function normalizeUserCode(userFnOrCode) {",
      "    let funcStr;",
      "    let codeMode = 'function';",
      "",
      "    if (typeof userFnOrCode === 'function') {",
      "      funcStr = userFnOrCode.toString();",
      "      codeMode = 'function';",
      "    } else if (typeof userFnOrCode === 'string') {",
      "      funcStr = userFnOrCode;",
      "",
      "      try {",
      "        // eslint-disable-next-line no-eval",
      "        eval('(' + funcStr + ')');",
      "        codeMode = 'function';",
      "      } catch {",
      "        codeMode = 'snippet';",
      "      }",
      "    } else {",
      "      throw new TypeError('userFnOrCode must be a function or a string');",
      "    }",
      "",
      "    return { funcStr, codeMode };",
      "  }",
      "",
      "  function canUseBunWorkerTimeout() {",
      "    return typeof Bun !== 'undefined' && typeof Worker !== 'undefined';",
      "  }",
      "",
      "  function runDirectWithAsyncTimeout(normalized, timeoutMs, args) {",
      "    const execution = Promise.resolve().then(async () => {",
      "      if (normalized.codeMode === 'snippet') {",
      "        // eslint-disable-next-line no-eval",
      "        eval(normalized.funcStr);",
      "        return undefined;",
      "      }",
      "",
      "      // eslint-disable-next-line no-eval",
      "      const fn = eval('(' + normalized.funcStr + ')');",
      "      return await fn.apply(null, args);",
      "    });",
      "",
      "    return Promise.race([",
      "      execution,",
      "      new Promise((_, reject) => {",
      "        setTimeout(() => {",
      "          reject(new Error('Timeout'));",
      "        }, timeoutMs);",
      "      }),",
      "    ]);",
      "  }",
      "",
      "  function runInBunWorker(normalized, timeoutMs, args) {",
      "    return new Promise((resolve, reject) => {",
      "      const workerSource = `",
      "        self.onmessage = async (event) => {",
      "          const { funcStr, args, codeMode } = event.data;",
      "",
      "          try {",
      "            if (codeMode === 'snippet') {",
      "              eval(funcStr);",
      "              self.postMessage({ status: 'finished', result: undefined });",
      "              return;",
      "            }",
      "",
      "            const fn = eval('(' + funcStr + ')');",
      "            const result = fn.apply(null, args);",
      "            const finalResult =",
      "              result && typeof result.then === 'function' ? await result : result;",
      "",
      "            self.postMessage({ status: 'finished', result: finalResult });",
      "          } catch (error) {",
      "            self.postMessage({",
      "              status: 'error',",
      "              error: error && (error.message || String(error)),",
      "            });",
      "          }",
      "        };",
      "      `;",
      "",
      "      const worker = new Worker(",
      "        URL.createObjectURL(",
      "          new Blob([workerSource], { type: 'text/javascript' }),",
      "        ),",
      "      );",
      "",
      "      const timer = setTimeout(() => {",
      "        worker.terminate();",
      "        reject(new Error('Timeout'));",
      "      }, timeoutMs);",
      "",
      "      worker.onmessage = (event) => {",
      "        clearTimeout(timer);",
      "        worker.terminate();",
      "",
      "        const payload = event.data;",
      "        if (payload && payload.status === 'finished') {",
      "          resolve(payload.result);",
      "          return;",
      "        }",
      "",
      "        if (payload && payload.status === 'error') {",
      "          reject(new Error(payload.error || 'Worker error'));",
      "          return;",
      "        }",
      "",
      "        reject(new Error('Unknown worker response'));",
      "      };",
      "",
      "      worker.onerror = (error) => {",
      "        clearTimeout(timer);",
      "        worker.terminate();",
      "        reject(error || new Error('Worker failed'));",
      "      };",
      "",
      "      worker.postMessage({ funcStr: normalized.funcStr, args, codeMode: normalized.codeMode });",
      "    });",
      "  }",
      "",
      "  const normalized = normalizeUserCode(userFnOrCode);",
      "  if (canUseBunWorkerTimeout()) return runInBunWorker(normalized, timeoutMs, args);",
      "  return runDirectWithAsyncTimeout(normalized, timeoutMs, args);",
      "}",
      "",
      "async function testSolution(cb) {",
      "  const fnName = cb.name;",
      "  console.log(`\\nTesting: \\${fnName}\\n`);",
      "",
      "  for (let i = 0; i < testCases.length; i++) {",
      "    const { case: caseName, input, output, timeout } = testCases[i];",
      "    const caseNo = i + 1;",
      "    const start = performance.now();",
      "    try {",
      "      const result = await runWithTimeout(cb, timeout ?? DEFAULT_TIMEOUT, ...input);",
      "      const elapsed = (performance.now() - start).toFixed(3);",
      "      console.assert(",
      "        JSON.stringify(result) === JSON.stringify(output),",
      "        `Expected: ${JSON.stringify(output)}, Got: ${JSON.stringify(result)}`",
      "      );",
      "      console.log(`✅ ${caseNo}. ${caseName || 'unnamed'} - ${elapsed}ms`, { input });",
      "    } catch (e) {",
      "      const elapsed = (performance.now() - start).toFixed(3);",
      "      if (e && e.message === 'Timeout') {",
      "        console.error('❌ ' + caseNo + '. ' + (caseName || 'unnamed') + ' - timeout after ' + (timeout ?? DEFAULT_TIMEOUT) + 'ms');",
      "      } else {",
      "        console.error('❌ ' + caseNo + '. ' + (caseName || 'unnamed') + ' - ' + elapsed + 'ms', {",
      "          input,",
      "          expected: output,",
      "          error: e,",
      "        });",
      "      }",
      "    }",
      "  }",
      "}",
      "main();"
    ],
    "description": "Scaffold JS/TS coding exercise with test cases, timing, assertions, array inputs, and per-test timeout"
  }
}
