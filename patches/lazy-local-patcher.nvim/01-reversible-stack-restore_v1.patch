+local function valid_relative(path)
+  assert(path ~= "" and not path:match("^[/\\]") and not path:match("^%a:"), "Invalid patch path: " .. path)
+  for part in (path .. "/"):gmatch("(.-)/") do
+    assert(part ~= "" and part ~= "." and part ~= ".." and part ~= ".git", "Unsafe patch path: " .. path)
+  end
+end
+
+-- lstat every component before opening anything: a lexical prefix alone does
+-- not prevent a directory symlink from escaping the repository.
+local function snapshot(root, relative)
+  valid_relative(relative)
+  local path = root
+  local parts = vim.split(relative, "/", { plain = true })
+  for i, part in ipairs(parts) do
+    path = path .. "/" .. part
+    local stat = uv.fs_lstat(path)
+    if stat then
+      assert(stat.type == (i == #parts and "file" or "directory"), "Refusing non-regular patch path: " .. path)
+    end
+  end
+  local stat = uv.fs_lstat(path)
+  if not stat then return { exists = false } end
+  local file = assert(io.open(path, "rb"))
+  local data = assert(file:read("*a")); file:close()
+  return { exists = true, data = data, mode = bit.band(stat.mode, 511) }
+end
+
+local function same(a, b)
+  return a.exists == b.exists and a.data == b.data and a.mode == b.mode
+end
+
+local function write_file(root, relative, value)
+  snapshot(root, relative) -- reject symlinks again immediately before mutation
+  local path = root .. "/" .. relative
+  if not value.exists then
+    if uv.fs_lstat(path) then assert(uv.fs_unlink(path)) end
+    return
+  end
+  vim.fn.mkdir(vim.fn.fnamemodify(path, ":h"), "p")
+  snapshot(root, relative)
+  local temporary = path .. ".lazy-patch-" .. tostring(uv.hrtime())
+  local fd = assert(uv.fs_open(temporary, "wx", value.mode))
+  local ok, err = pcall(function()
+    local offset = 0
+    while offset < #value.data do
+      local written = assert(uv.fs_write(fd, value.data:sub(offset + 1), offset))
+      assert(written > 0, "Short write: " .. temporary)
+      offset = offset + written
+    end
+    assert(uv.fs_close(fd)); fd = nil
+    assert(uv.fs_chmod(temporary, value.mode))
+    assert(uv.fs_rename(temporary, path))
+  end)
+  if fd then uv.fs_close(fd) end
+  if not ok then uv.fs_unlink(temporary); error(err) end
+end
+
+local function owned_paths(repo, patches)
+  local owned = {}
+  for _, patch in ipairs(patches) do
+    local records = vim.split(checked(M.git_execute(repo, { "apply", "--numstat", "-z", patch }), "Invalid patch: " .. patch), "\0", { plain = true })
+    local i = 1
+    while records[i] and records[i] ~= "" do
+      local path = assert(records[i]:match("^[^\t]*\t[^\t]*\t(.*)$"), "Invalid patch statistics")
+      if path == "" then -- git's NUL-separated rename format
+        for j = 1, 2 do
+          local renamed = assert(records[i + j]); valid_relative(renamed); owned[renamed] = true
+        end
+        i = i + 3
+      else
+        valid_relative(path); owned[path] = true; i = i + 1
+      end
+    end
+  end
+  local paths = vim.tbl_keys(owned); table.sort(paths)
+  return paths, owned
+end
+
+-- This helper mutates disposable checkouts only. A legacy git restore can
+-- leave exact generated files behind; unknown contents always block recovery.
+local function remove_orphans(repo, patch, clean_baseline)
+  local removed = {}
+  for _, file in ipairs(generated_files(patch)) do
+    local value = snapshot(repo, file.path)
+    local tracked = M.git_execute(repo, { "ls-files", "--error-unmatch", "--", file.path }).success
+    if not tracked and value.exists and value.data == file.content then
+      removed[file.path] = value
+      write_file(repo, file.path, { exists = false })
+    end
+  end
+  if not next(removed) then return false end
+  if clean_baseline or M.git_execute(repo, { "apply", "--check", "--ignore-space-change", patch }).success then return true end
+  for path, value in pairs(removed) do write_file(repo, path, value) end
+  return false
+end
+
+local function restore_preflight(repo, patches)
+  local unresolved = {}
+  for index = #patches, 1, -1 do
+    local patch = patches[index]
+    if M.git_execute(repo, { "apply", "--reverse", "--check", "--ignore-space-change", patch }).success then
+      checked(M.git_execute(repo, { "apply", "--reverse", "--ignore-space-change", patch }), "Cannot reverse " .. patch)
+    elseif not M.git_execute(repo, { "apply", "--check", "--ignore-space-change", patch }).success
+      and not remove_orphans(repo, patch) then
+      table.insert(unresolved, patch)
+    end
   end
-  vim.notify(patcher .. "Restored " .. name, vim.log.levels.TRACE)
+  if #unresolved == 0 then return end
+  assert(vim.trim(checked(M.git_execute(repo, { "status", "--porcelain", "--untracked-files=no" }), "Cannot inspect preflight")) == "",
+    "Cannot safely restore " .. unresolved[#unresolved] .. "; conflicting changes preserved")
+  for _, patch in ipairs(patches) do
+    remove_orphans(repo, patch, true)
+    for _, file in ipairs(generated_files(patch)) do
+      assert(not snapshot(repo, file.path).exists, "Unknown generated-file content preserved: " .. file.path)
+    end
+  end
+end
+
+local function commit_plan(repo, paths, before, after)
+  local changed = {}
+  for _, path in ipairs(paths) do
+    assert(same(snapshot(repo, path), before[path]), "File changed during preflight: " .. path)
+    if not same(before[path], after[path]) then table.insert(changed, path) end
+  end
+  if #changed == 0 then return end
+  local backup = vim.fn.stdpath("state") .. "/lazy-local-patcher/transactions/" .. tostring(uv.hrtime())
+  vim.fn.mkdir(backup, "p")
+  local manifest = { repository = repo, files = {} }
+  for _, path in ipairs(changed) do
+    local value = before[path]
+    manifest.files[path] = { exists = value.exists, mode = value.mode }
+    if value.exists then write_file(backup, path, value) end
+  end
+  vim.fn.writefile({ vim.json.encode(manifest) }, backup .. "/manifest.json")
+  local written = {}
+  local ok, err = pcall(function()
+    for _, path in ipairs(changed) do
+      assert(same(snapshot(repo, path), before[path]), "File changed before commit: " .. path)
+      write_file(repo, path, after[path]); table.insert(written, path)
+    end
+  end)
+  if ok then return end
+  local rollback_ok = true
+  for index = #written, 1, -1 do
+    local path = written[index]
+    local restored = pcall(function()
+      assert(same(snapshot(repo, path), after[path]), "Concurrent edit during rollback: " .. path)
+      write_file(repo, path, before[path])
+    end)
+    rollback_ok = rollback_ok and restored
+  end
+  error(tostring(err) .. (rollback_ok and "\nOriginal files restored. Backup: " or "\nInspect rollback failure. Backup: ") .. backup)
+end
+
+-- One repository transaction: prove the whole operation in a disposable clone,
+-- then commit only its owned paths. Neither an unsafe restore nor a late patch
+-- failure can leave a partially applied stack in the installed checkout.
+local function transact(name, plugin_path, patches, apply)
+  local temporary = vim.fn.tempname()
+  local ok, err = pcall(function()
+    local repo = assert(uv.fs_realpath(plugin_path), "Plugin not installed: " .. plugin_path)
+    local top = vim.trim(checked(M.git_execute(repo, { "rev-parse", "--show-toplevel" }), "Not a plugin repository"))
+    assert(uv.fs_realpath(top) == repo, "Refusing parent repository: " .. plugin_path)
+    local head = vim.trim(checked(M.git_execute(repo, { "rev-parse", "HEAD" }), "Cannot resolve plugin HEAD"))
+    local paths, owned = owned_paths(repo, patches)
+    local staged = checked(M.git_execute(repo, { "diff", "--cached", "--name-only", "-z" }), "Cannot inspect index")
+    for _, path in ipairs(vim.split(staged, "\0", { plain = true })) do
+      assert(not owned[path], "Staged changes preserved: " .. path)
+    end
+    local before, after = {}, {}
+    for _, path in ipairs(paths) do before[path] = snapshot(repo, path) end
+    local output = vim.fn.system({ "git", "clone", "--quiet", "--shared", "--no-checkout", repo, temporary })
+    assert(vim.v.shell_error == 0, "Cannot create preflight checkout: " .. output)
+    checked(M.git_execute(temporary, { "checkout", "--quiet", "--detach", head }), "Cannot checkout plugin baseline")
+    for _, path in ipairs(paths) do write_file(temporary, path, before[path]) end
+    restore_preflight(temporary, patches)
+    if apply then
+      for _, patch in ipairs(patches) do
+        assert(M.apply_patch(name .. "/" .. vim.fn.fnamemodify(patch, ":t"), patch, temporary), "Patch preflight failed: " .. patch)
+      end
+    end
+    for _, path in ipairs(paths) do
+      after[path] = snapshot(temporary, path)
+      if before[path].exists and after[path].exists then
+        -- Git rewrites 0600 as 0644. Preserve private access bits; honor an
+        -- intentional executable-mode change only for existing read access.
+        local mode = before[path].mode
+        if bit.band(mode, 64) ~= bit.band(after[path].mode, 64) then
+          mode = bit.band(mode, 438) -- 0666
+          if bit.band(after[path].mode, 64) ~= 0 then
+            mode = bit.bor(mode, bit.rshift(bit.band(mode, 292), 2)) -- 0444 -> 0111
+          end
+        end
+        after[path].mode = mode
+      end
+    end
+    assert(vim.trim(checked(M.git_execute(repo, { "rev-parse", "HEAD" }), "Cannot recheck plugin HEAD")) == head,
+      "Plugin HEAD changed during preflight")
+    assert(checked(M.git_execute(repo, { "diff", "--cached", "--name-only", "-z" }), "Cannot recheck index") == staged,
+      "Plugin index changed during preflight")
+    commit_plan(repo, paths, before, after)
+  end)
+  vim.fn.delete(temporary, "rf")
+  if not ok then
+    vim.notify(patcher .. name .. ": " .. tostring(err), vim.log.levels.ERROR)
+    return false
+  end
+  vim.notify(patcher .. (apply and "Applied " or "Restored patches from ") .. name, vim.log.levels.TRACE)
+  return true
+end
+
+---@param name string
+---@param plugin_path string
+---@param patches string[]
+function M.restore_repo(name, plugin_path, patches)
+  return transact(name, plugin_path, patches, false)
 end

