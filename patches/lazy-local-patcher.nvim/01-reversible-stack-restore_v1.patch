 ---@param plugin_path string Full path of the plugin repository
-function M.restore_repo(name, plugin_path)
-  local out = M.git_execute(plugin_path, { "restore", "." })
-  if not out.success then
-    local msg = string.format(": Error restoring the repository. Check '%s'", plugin_path)
+---@param patch_paths string[] Patches for this repository, in apply order
+---@return boolean restored Whether every applied patch was reversed or already absent
+function M.restore_repo(name, plugin_path, patch_paths)
+  local status = M.git_execute(plugin_path, { "status", "--porcelain" })
+  if not status.success then
+    local msg = string.format(": Error checking the repository. Check '%s'", plugin_path)
     vim.notify(patcher .. name .. msg, vim.log.levels.ERROR)
+    return false
+  end
+  if vim.trim(status.output) == "" then
+    vim.notify(patcher .. "Already restored " .. name, vim.log.levels.TRACE)
+    return true
+  end
+
+  local unresolved = {}
+  for index = #patch_paths, 1, -1 do
+    local patch_path = patch_paths[index]
+    local reverse_check = M.git_execute(plugin_path, { "apply", "--reverse", "--check", "--ignore-space-change", patch_path })
+    if reverse_check.success then
+      local out = M.git_execute(plugin_path, { "apply", "--reverse", "--ignore-space-change", patch_path })
+      if not out.success then
+        local msg = string.format(": Error restoring patch '%s'. Check '%s'", patch_path, plugin_path)
+        vim.notify(patcher .. name .. msg, vim.log.levels.ERROR)
+        return false
+      end
+    else
+      -- An absent patch can depend on an earlier patch that is also absent.
+      -- Keep unwinding older patches first; final repository cleanliness below
+      -- distinguishes that partial stack from a real local conflict.
+      local forward_check = M.git_execute(plugin_path, { "apply", "--check", "--ignore-space-change", patch_path })
+      if not forward_check.success then
+        table.insert(unresolved, patch_path)
+      end
+    end
+  end
+
+  if #unresolved > 0 then
+    local final_status = M.git_execute(plugin_path, { "status", "--porcelain" })
+    if not final_status.success or vim.trim(final_status.output) ~= "" then
+      local msg = string.format(
+        ": Cannot safely restore patch '%s'; refusing to overwrite local changes. Check '%s'",
+        unresolved[#unresolved],
+        plugin_path
+      )
+      vim.notify(patcher .. name .. msg, vim.log.levels.ERROR)
+      return false
+    end
   end
-  vim.notify(patcher .. "Restored " .. name, vim.log.levels.TRACE)
+
+  vim.notify(patcher .. "Restored patches from " .. name, vim.log.levels.TRACE)
+  return true
 end
 
