     STATUS_SUCCESS = "success",
 }
 
+---Return false for editor context, rules, and hidden context lines stored
+---outside msg.opts by CodeCompanion v19.
+---@param msg CodeCompanion.History.ChatMessage
+---@return boolean
+local function is_title_relevant_message(msg)
+    local opts = msg.opts or {}
+    local meta = msg._meta or opts._meta or {}
+    local context = msg.context or opts.context or {}
+    local has_content = msg.content and vim.trim(msg.content) ~= ""
+    local is_context = opts.tag or opts.reference or opts.context_id
+        or meta.tag or meta.reference or meta.context_id
+        or context.id or context.reference or context.context_id
+    -- v19 sets visible=false on every injected context line (rules, file/buffer/
+    -- URL attachments, tool prompts), so hidden messages are context even when
+    -- a tag or context id is missing.
+    local is_hidden = opts.visible == false or msg.visible == false
+
+    return has_content and not is_context and not is_hidden
+end
+
+---Strip picker-expanded annotations from message content. CodeCompanion
+---replaces @{tool}, @{group}, and #{buffer} references in submitted prompts
+---with the configured tool replacement message, tool-group prompt, and buffer
+---note (see codecompanion.interactions.chat.tools). When a message is only
+---such annotations plus a trivial remainder (for example a greeting), the
+---annotations would dominate the title prompt, so the remainder is returned
+---instead. Messages whose remainder is not trivial are returned unchanged so
+---real requests that mention tools keep their full context.
+---@param content string
+---@return string
+local function strip_picker_annotations(content)
+    local tools_cfg = config.interactions and config.interactions.chat and config.interactions.chat.tools
+    if type(tools_cfg) ~= "table" then
+        return content
+    end
+
+    local stripped = content
+
+    -- Tool-group prompts, e.g. "I'm giving you access to ${tools} to help you
+    -- perform file operations" (config.interactions.chat.tools.groups)
+    for _, group in pairs(tools_cfg.groups or {}) do
+        if type(group) == "table" and type(group.prompt) == "string" and type(group.tools) == "table" then
+            local fragment = group.prompt:gsub("%${tools}", table.concat(group.tools, ", ") .. " tools")
+            stripped = stripped:gsub(vim.pesc(fragment), "")
+        end
+    end
+
+    -- Per-tool replacement text, e.g. "the ${tool} tool"
+    -- (config.interactions.chat.tools.opts.tool_replacement_message)
+    local tool_replacement = (tools_cfg.opts or {}).tool_replacement_message
+    if type(tool_replacement) == "string" then
+        for name, value in pairs(tools_cfg) do
+            if name ~= "opts" and name ~= "groups" and type(value) == "table" then
+                stripped = stripped:gsub(vim.pesc(tool_replacement:gsub("%${tool}", name)), "")
+            end
+        end
+    end
+
+    -- Buffer notes, e.g. "file `path` (with buffer number: 32)"
+    stripped = stripped:gsub("file `[^`]*` %(with buffer number: %d+%)", "")
+
+    stripped = stripped:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
+    if stripped == content then
+        return content
+    end
+
+    -- Only replace content when the remainder is trivial (empty or at most
+    -- two words). Otherwise keep the original so requests that merely mention
+    -- tools or attachments are preserved.
+    local word_count = #vim.split(stripped, "%s+", { trimempty = true })
+    if stripped == "" or word_count <= 2 then
+        return stripped
+    end
+
+    return content
+end
+
