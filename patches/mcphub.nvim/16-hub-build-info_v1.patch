+
+local function display(value)
+    if value == nil or value == "" then
+        return "—"
+    end
+    return tostring(value)
+end
+
+local function render_hub_build(cache)
+    if cache.status == "waiting" then
+        return "# Hub Build (running server)\n\nWaiting for the hub connection..."
+    elseif cache.status == "loading" then
+        return "# Hub Build (running server)\n\nLoading build info from the connected hub..."
+    elseif cache.status == "unavailable" then
+        return "# Hub Build (running server)\n\nBuild info unavailable — this hub binary predates `/api/build-info`. Rebuild and restart the hub to inspect its identity."
+    elseif cache.status ~= "loaded" or type(cache.data) ~= "table" then
+        return "# Hub Build (running server)\n\nCould not load build info: " .. display(cache.error)
+    end
+
+    local build = cache.data.build or {}
+    local runtime = cache.data.runtime or {}
+    local commit = display(build.shortCommit or build.commit)
+    if build.dirty then
+        commit = commit .. " (+dirty)"
+    end
+    if build.branch then
+        commit = commit .. " on " .. build.branch
+    end
+    local lines = {
+        "# Hub Build (running server)",
+        "",
+        "Version: " .. display(build.version),
+        "Commit: " .. commit,
+        "Subject: " .. display(build.commitSubject),
+        "Committed: " .. display(build.commitDate),
+        "Built: " .. display(build.builtAt),
+        "Started: " .. display(runtime.startedAt),
+        "Uptime: " .. display(runtime.uptimeMs and math.floor(runtime.uptimeMs / 1000) .. "s"),
+        "PID: " .. display(runtime.pid) .. "   Node: " .. display(runtime.node) .. "   Port: " .. display(runtime.port),
+        "Binary: " .. display(runtime.binaryPath),
+        "Config: " .. display(runtime.configPath),
+        "",
+        "## Features",
+    }
+    local features = build.features or {}
+    for _, name in ipairs({ "clearAuth", "leanProxy", "stdioAuthCommand" }) do
+        table.insert(lines, (features[name] and "[x] " or "[ ] ") .. name)
+    end
+    table.insert(lines, "OAuth redirect styles: " .. table.concat(features.oauthRedirectStyles or {}, ", "))
+    table.insert(lines, "")
+    table.insert(lines, "## Applied patches")
+    if #((build.patches) or {}) == 0 then
+        table.insert(lines, "None declared (capabilities may be committed in the fork).")
+    else
+        for _, patch in ipairs(build.patches) do
+            table.insert(lines, "[x] " .. display(patch.name))
+        end
+    end
+    table.insert(lines, "")
+    table.insert(lines, "## Changes since " .. display(build.releaseTag))
+    table.insert(lines, "Release tag commit: " .. display(build.releaseTagCommitDate))
+    if #((build.changelog) or {}) == 0 then
+        table.insert(lines, "No commits listed.")
+    else
+        for _, change in ipairs(build.changelog) do
+            if type(change) == "table" then
+                table.insert(lines, "- " .. display(change.committedAt) .. "  " .. display(change.commit) .. "  " .. display(change.subject))
+            else
+                -- Builds produced before dated entries used plain strings.
+                table.insert(lines, "- " .. tostring(change))
+            end
+        end
+    end
+    return table.concat(lines, "\n")
 end
 
