diff --git c/lua/mcphub/ui/build_info.lua w/lua/mcphub/ui/build_info.lua
new file mode 100644
index 0000000..0ad1ec3
--- /dev/null
+++ w/lua/mcphub/ui/build_info.lua
@@ -0,0 +1,76 @@
+local State = require("mcphub.state")
+
+local M = {}
+
+-- One request per attached hub process. Main and Help share the same snapshot,
+-- so dashboard redraws and tab changes never cause a build-info request storm.
+function M.get_cache(ui)
+    local hub = State.hub_instance
+    if not hub or not hub.ready or not State:is_connected() then
+        return { status = "waiting" }
+    end
+
+    local port = tostring((State.current_hub or {}).port or hub.port or "")
+    local pid = (State.server_state or {}).pid
+    local cache = State.hub_build_info
+    if cache and cache.hub == hub and cache.port == port and cache.pid == pid and cache.url == hub.server_url then
+        return cache
+    end
+
+    cache = { status = "loading", hub = hub, port = port, pid = pid, url = hub.server_url }
+    State.hub_build_info = cache
+    hub:get_build_info({
+        callback = function(response, err)
+            if State.hub_build_info ~= cache then
+                return
+            end
+            cache.data = response
+            cache.error = err
+            cache.status = response and "loaded" or (err and err:find("404") and "unavailable" or "error")
+            if ui.is_shown and (ui.current_view == "main" or ui.current_view == "help") then
+                ui:schedule_render()
+            end
+        end,
+    })
+    return cache
+end
+
+-- Home and Hub Build use the same confirmed, non-reconnecting stop action.
+function M.stop_hub(ui)
+    local cache = M.get_cache(ui)
+    local hub = State.hub_instance
+    if not hub or not State:is_connected() then
+        vim.notify("MCP Hub is not connected", vim.log.levels.WARN)
+        return
+    end
+    local features = ((cache.data or {}).build or {}).features or {}
+    if cache.status ~= "loaded" or not features.stopHub then
+        vim.notify("This running hub does not advertise the stop endpoint", vim.log.levels.WARN)
+        return
+    end
+    local runtime = cache.data.runtime or {}
+    local choice = vim.fn.confirm(
+        string.format(
+            "Stop the current MCP Hub process?\n\nPort: %s   PID: %s\nOther clients will disconnect. This Neovim will not reconnect until you press R.",
+            tostring(runtime.port or hub.port or "unknown"),
+            tostring(runtime.pid or "unknown")
+        ),
+        "&Stop hub\n&Cancel",
+        2,
+        "Warning"
+    )
+    if choice ~= 1 then
+        return
+    end
+    hub:stop_server({
+        callback = function(ok, err)
+            if ok then
+                vim.notify("MCP Hub stopped; press R to start it again", vim.log.levels.INFO)
+            else
+                vim.notify("Could not stop MCP Hub: " .. tostring(err), vim.log.levels.ERROR)
+            end
+        end,
+    })
+end
+
+return M
