+        callback = function(response, err)
+            if err or not response or response.status ~= "stopping" then
+                self.manual_stop = false
+                if opts.callback then opts.callback(false, err or "unexpected stop response") end
+                return
+            end
+            self:stop()
+            if opts.callback then opts.callback(true) end
+        end,
+    })
+end
