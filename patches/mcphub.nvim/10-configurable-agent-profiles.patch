     return nil
 end
 
+function MainView:_get_agent_registry_config()
+    return (mcphub_config.ui or {}).agent_registry or {}
+end
+
+function MainView:_get_agent_scopes(agent_cfg)
+    local cfg = self:_get_agent_registry_config()
+    return agent_cfg.scopes or cfg.scopes or { "user", "project" }
+end
+
+function MainView:_get_default_agent_target()
+    local cfg = self:_get_agent_registry_config()
+    local agents_cfg = cfg.agents or {}
+    local helper = require("utils.mcphub_agents")
+    local wanted = cfg.default_agent_id
+    local selected_cfg = agents_cfg[1]
+    local selected_profile = selected_cfg and helper.normalize_profile(selected_cfg) or helper.normalize_profile("claude")
+
+    if wanted then
+        for _, agent_cfg in ipairs(agents_cfg) do
+            local profile = helper.normalize_profile(agent_cfg)
+            if profile.id == wanted or profile.name == wanted or profile.label == wanted then
+                selected_cfg = agent_cfg
+                selected_profile = profile
+                break
+            end
+        end
+    end
+
+    local scopes = selected_cfg and self:_get_agent_scopes(selected_cfg) or { "user" }
+    return {
+        profile = selected_profile,
+        label = selected_profile.label,
+        scope = cfg.default_scope or scopes[1] or "user",
+        binding_flat = (selected_cfg and selected_cfg.binding_flat) or "mcphub",
+        binding_lean = (selected_cfg and selected_cfg.binding_lean) or "mcphub-lean",
+    }
+end
+
