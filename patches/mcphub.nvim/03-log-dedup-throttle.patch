@@ -101,6 +101,23 @@
                 hub:refresh()
             end
         elseif event == constants.EventTypes.LOG then
+            -- Map server log type strings to vim.log.levels for comparison
+            local server_level_map = {
+                debug = vim.log.levels.DEBUG,
+                info = vim.log.levels.INFO,
+                warn = vim.log.levels.WARN,
+                error = vim.log.levels.ERROR,
+            }
+            local msg_level = server_level_map[data.type] or vim.log.levels.INFO
+            local cfg_level = (State.config.log or {}).level or vim.log.levels.INFO
+            -- Drop SSE log messages below the configured log level. This makes
+            -- the `log.level` option apply to the full server output stream, not
+            -- just vim.notify calls (which was the previous behaviour).
+            -- Errors are always stored regardless of level.
+            if msg_level < cfg_level and data.type ~= "error" then
+                return
+            end
+
             -- Use message timestamp if valid ISO string, otherwise system time
             local timestamp = vim.loop.now()
             if data.timestamp then
