 -- Common result rendering
-function CapabilityHandler:render_result()
+function CapabilityHandler:render_result(line_offset)
     if not self.state.result then
         return {}
     end
@@ -199,11 +211,51 @@ function CapabilityHandler:render_result()
     local lines = {}
     table.insert(lines, Text.pad_line(NuiLine())) -- Empty line
     vim.list_extend(lines, self:render_section_start("Result"))
-    vim.list_extend(lines, self:render_output(self.state.result))
+    vim.list_extend(lines, self:render_output(self.state.result, line_offset and (line_offset + #lines)))
     vim.list_extend(lines, self:render_section_end())
     return lines
 end
 
+function CapabilityHandler:get_yank_value(line)
+    local type, context = self:get_line_info(line)
+    if type == "result" and context and context.text then
+        return context.text, "result"
+    end
+    return nil, nil
+end
+
+function CapabilityHandler:get_result_text()
+    local result = self.state.result
+    if not result then
+        return ""
+    end
+
+    if type(result.text) == "string" and result.text ~= "" then
+        return result.text
+    end
+
+    if type(result.messages) == "table" then
+        local parts = {}
+        for _, message in ipairs(result.messages) do
+            local output = message.output or {}
+            local role = message.role
+            if type(output.text) == "string" and output.text ~= "" then
+                if role and role ~= "" then
+                    table.insert(parts, role .. ":\n" .. output.text)
+                else
+                    table.insert(parts, output.text)
+                end
+            end
+        end
+        if #parts > 0 then
+            return table.concat(parts, "\n\n")
+        end
+    end
+
+    local ok, encoded = pcall(vim.json.encode, result)
+    return ok and encoded or vim.inspect(result)
+end
+
 -- Error handling
 function CapabilityHandler:handle_response(response, err)
     self.state.is_executing = false
