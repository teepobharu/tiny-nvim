diff --git i/lua/mcphub/utils/renderer.lua w/lua/mcphub/utils/renderer.lua
index 9e8eaad..8bfe431 100644
--- i/lua/mcphub/utils/renderer.lua
+++ w/lua/mcphub/utils/renderer.lua
@@ -4,9 +4,86 @@ local Text = require("mcphub.utils.text")
 local config_manager = require("mcphub.utils.config_manager")
 local constants = require("mcphub.utils.constants")
 local utils = require("mcphub.utils")
+local prompt_utils = require("mcphub.utils.prompt")
 
 local M = {}
 local tool_regex_cache = {}
+local get_tool_filter_matchers
+
+local function token_counts_enabled(scope)
+    local cfg = (((State.config or {}).ui or {}).token_counts or {})
+    if cfg.enabled == false then
+        return false
+    end
+    return cfg[scope] ~= false
+end
+
+local function append_token_count(line, token_count)
+    if token_count and token_count > 0 then
+        line:append(" ~" .. utils.format_token_count(token_count) .. "t", Text.highlights.muted)
+    end
+end
+
+function M.estimate_tool_tokens(tool)
+    local ok, text = pcall(function()
+        local input_schema = prompt_utils.get_inputSchema(tool)
+        return string.format(
+            "- %s: %s\n\n  Input Schema:\n\n  ```json\n  %s\n  ```",
+            tool.name,
+            prompt_utils.get_description(tool):gsub("\n", "\n  "),
+            utils.pretty_json(vim.json.encode(input_schema)):gsub("\n", "\n  ")
+        )
+    end)
+    return ok and utils.calculate_tokens(text) or 0
+end
+
+local function filter_server_for_prompt(server, server_config)
+    local filtered = vim.deepcopy(server)
+    server_config = server_config or {}
+
+    if not filtered.capabilities then
+        return filtered
+    end
+
+    local tool_matchers = get_tool_filter_matchers(server_config)
+    local filters = {
+        tools = { list = "disabled_tools", id = "name" },
+        resources = { list = "disabled_resources", id = "uri" },
+        resourceTemplates = { list = "disabled_resourceTemplates", id = "uriTemplate" },
+        prompts = { list = "disabled_prompts", id = "name" },
+    }
+
+    for cap_type, filter in pairs(filters) do
+        local capabilities = filtered.capabilities[cap_type]
+        if capabilities then
+            filtered.capabilities[cap_type] = vim.tbl_filter(function(item)
+                local item_id = item[filter.id]
+                if vim.tbl_contains(server_config[filter.list] or {}, item_id) then
+                    return false
+                end
+                if cap_type == "tools" then
+                    if vim.tbl_contains(server_config.removed_tools or {}, item_id) then
+                        return false
+                    end
+                    if tool_matchers.enabled and not tool_matchers.enabled:match_str(item_id) then
+                        return false
+                    end
+                    if tool_matchers.denied and tool_matchers.denied:match_str(item_id) then
+                        return false
+                    end
+                end
+                return true
+            end, capabilities)
+        end
+    end
+
+    return filtered
+end
+
+function M.estimate_server_tokens(server, server_config)
+    local ok, text = pcall(prompt_utils.server_to_text, filter_server_for_prompt(server, server_config))
+    return ok and utils.calculate_tokens(text) or 0
+end
 
