diff --git c/lua/mcphub/ui/init.lua w/lua/mcphub/ui/init.lua
--- c/lua/mcphub/ui/init.lua
+++ w/lua/mcphub/ui/init.lua
@@ -440,11 +440,47 @@ function UI:show(args)
     -- Focus window
     vim.api.nvim_set_current_win(self.window)
 
+    -- Re-resolve context: if cwd has moved to a different hub (e.g. workspace -> global)
+    -- and patch 12's debounce timer hasn't fired yet, switch hubs now so the UI shows the
+    -- hub matching the current cwd. start() short-circuits to connect_sse when the target
+    -- port is already running our server, so this is a fast SSE-reconnect, not a process restart.
+    self:reconcile_context()
+
     -- Draw current view
     self:render()
     self.is_shown = true
 end
 
+--- Reconcile UI's hub against current cwd. No-op unless workspace mode is enabled
+--- and the resolved port differs from the connected one.
+function UI:reconcile_context()
+    local hub = State.hub_instance
+    if not hub then
+        return
+    end
+    if not (State.config and State.config.workspace and State.config.workspace.enabled) then
+        return
+    end
+    local resolved = hub:resolve_context()
+    if not resolved then
+        return
+    end
+    local current = State.current_hub
+    if current and tostring(resolved.port) == tostring(current.port) then
+        return
+    end
+    -- Cancel any pending debounced switch (patch 12) so we don't fight it
+    if hub._pending_switch_timer then
+        pcall(hub._pending_switch_timer.stop, hub._pending_switch_timer)
+        pcall(hub._pending_switch_timer.close, hub._pending_switch_timer)
+        hub._pending_switch_timer = nil
+    end
+    hub:stop_sse()
+    vim.schedule(function()
+        hub:start()
+    end)
+end
+
 --- Render current view
 ---@private
 function UI:render()
