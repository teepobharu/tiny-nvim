+                })
                 return
             end
 
@@ -461,8 +483,11 @@ function MCPHub:start()
                     self:connect_sse()
                 else
                     log.debug("Config files changed, restarting server")
-                    vim.notify("Config files changed. Restarting hub...", vim.log.levels.INFO)
-                    self:handle_same_port_different_config(context)
+                    vim.notify("Config files changed. Waiting for hard restart confirmation...", vim.log.levels.WARN)
+                    self:handle_same_port_different_config(context, {
+                        reason = "config files changed",
+                        allow_connect = true,
+                    })
                 end
             else
                 -- No config info available (backwards compatibility)
@@ -1427,9 +1452,70 @@ function MCPHub:handle_hub_stopping()
     end
 end
 
+--- Ask what to do before killing an existing hub process.
+---@param context table Context containing port and config details
+---@param opts? { reason?: string, allow_connect?: boolean }
+---@return "restart"|"connect"|"cancel"
+function MCPHub:confirm_hard_restart(context, opts)
+    opts = opts or {}
+    local allow_connect = opts.allow_connect ~= false
+    local reason = opts.reason or "hub context mismatch"
+
+    if config.confirm_hard_restart == false then
+        return "restart"
+    end
+
+    if #vim.api.nvim_list_uis() == 0 then
+        vim.notify(
+            "MCP Hub hard restart needs confirmation but no UI is attached: " .. reason,
+            vim.log.levels.WARN
+        )
+        return allow_connect and "connect" or "cancel"
+    end
+
+    local existing_hub = context.existing_hub or {}
+    local message = table.concat({
+        "Hard restart MCP Hub?",
+        "",
+        "Reason: " .. reason,
+        "Port: " .. tostring(context.port),
+        "Existing PID: " .. tostring(existing_hub.pid or "unknown"),
+        "Existing config: " .. format_config_files(existing_hub.config_files),
+        "Current config: " .. format_config_files(context.config_files),
+        "",
+        "This will disconnect other Neovim and CLI clients on the same hub.",
+    }, "\n")
+
+    if allow_connect then
+        local choice = vim.fn.confirm(message, "&Connect to existing\n&Hard restart\n&Cancel", 1, "Warning")
+        if choice == 1 then
+            return "connect"
+        elseif choice == 2 then
+            return "restart"
+        end
+        return "cancel"
+    end
+
+    local choice = vim.fn.confirm(message, "&Hard restart\n&Cancel", 2, "Warning")
+    return choice == 1 and "restart" or "cancel"
+end
+
 --- Handles already running mcp-hub on same port with different config files
 ---@param context table Context containing port and config details
-function MCPHub:handle_same_port_different_config(context)
+---@param opts? { reason?: string, allow_connect?: boolean }
+function MCPHub:handle_same_port_different_config(context, opts)
+    opts = opts or {}
+    local action = self:confirm_hard_restart(context, opts)
+    if action == "connect" then
+        vim.notify("Connecting to existing MCP Hub without hard restart", vim.log.levels.INFO)
+        self:connect_sse()
+        return
+    elseif action == "cancel" then
+        vim.notify("MCP Hub hard restart cancelled: " .. (opts.reason or "hub context mismatch"), vim.log.levels.WARN)
+        self:_clean_up()
+        return
+    end
+
     self:api_request("POST", "hard-restart", {
         callback = function(_, err)
             if err then
@@ -1448,6 +1512,8 @@ function MCPHub:handle_same_port_different_config(context, opts)
                 return
             end
-            self:_start_server_with_context(context)
+            vim.defer_fn(function()
+                self:_start_server_with_context(context)
+            end, 1000)
         end,
         skip_ready_check = true,
     })
