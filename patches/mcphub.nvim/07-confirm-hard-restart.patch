# Patch: confirm before hard restart
# Plugin: ravitemer/mcphub.nvim
# Tested against: 163b3ad [v6.2.0] with local patches 01-06 applied
#
# Problem: mcphub.nvim could post `/api/hard-restart` during startup without a
# visible decision point when it found a compatible hub on the same port but had
# missing/different workspace cache metadata. That disconnects other Neovim and
# CLI clients on the same hub without explicit user intent.
#
# Fix: add `confirm_hard_restart` (default true), prompt before every hard
# restart for automatic startup mismatch cases, and default config/cache
# mismatch cases to "connect to existing" so a second Neovim does not replace a
# running hub unless the user explicitly chooses to. Manual `R` remains an
# explicit hard restart and does not prompt.

diff --git i/lua/mcphub/config.lua w/lua/mcphub/config.lua
--- i/lua/mcphub/config.lua
+++ w/lua/mcphub/config.lua
@@ -62,5 +62,6 @@ local defaults = {
     auto_approve = false,
     auto_toggle_mcp_servers = true, -- Let LLMs start and stop MCP servers automatically
+    confirm_hard_restart = true, -- Ask before automatic startup hard restart
     use_bundled_binary = false, -- Whether to use bundled mcp-hub binary
     ---@type table | fun(context: MCPHub.JobContext): table Global environment variables available to all MCP servers
     global_env = {}, -- Environment variables that will be available to all MCP servers
diff --git i/lua/mcphub/hub.lua w/lua/mcphub/hub.lua
--- i/lua/mcphub/hub.lua
+++ w/lua/mcphub/hub.lua
@@ -16,6 +16,20 @@ local utils = require("mcphub.utils")
 
 local tool_regex_cache = {}
 
+---@param files table|nil
+---@return string
+local function format_config_files(files)
+    if type(files) ~= "table" then
+        return "<unknown>"
+    end
+
+    local normalized = {}
+    for _, file in ipairs(files) do
+        table.insert(normalized, tostring(file))
+    end
+    return table.concat(normalized, ", ")
+end
+
 --- Resolve a regex value from server env keys.
 ---@param env table<string, any>
 ---@param preferred_keys string[]
@@ -441,8 +457,11 @@ function MCPHub:start()
             end
             if not is_same_version then
                 log.debug("Existing server is not of same version, restarting")
-                vim.notify("mcp-hub version mismatch. Restarting hub...", vim.log.levels.INFO)
-                self:handle_same_port_different_config(context)
+                vim.notify("mcp-hub version mismatch. Waiting for hard restart confirmation...", vim.log.levels.WARN)
