+                        break
+                    end
+                end
+            end
+        end
+    end
+
+    if #parts > 0 then
+        local instructions_header = (header and header ~= "") and string.format(header, server_name)
+            or string.format("\n\n#### Instructions for `%s` server\n\n", server_name)
+        return instructions_header .. table.concat(parts)
