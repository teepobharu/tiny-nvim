+local DEFAULT_CUSTOM_INSTRUCTIONS_MAX_BYTES = 8 * 1024
+local instruction_file_cache = {}
+local instruction_file_warnings = {}
+
+---@param path string
+---@return boolean
+local function is_absolute_path(path)
+    return path:sub(1, 1) == "/" or path:match("^%a:[/\\]") ~= nil or path:match("^[/\\][/\\]") ~= nil
+end
+
+---@param path string
+---@param config_source string|nil
+---@return string|nil
+local function resolve_instruction_path(path, config_source)
+    local expanded = vim.fn.expand(path)
+    if is_absolute_path(expanded) then
+        return vim.fs.normalize(expanded)
+    end
+    if not config_source or config_source == "" then
+        return nil
+    end
+    local config_dir = vim.fn.fnamemodify(vim.fn.expand(config_source), ":p:h")
+    return vim.fs.normalize(vim.fs.joinpath(config_dir, expanded))
+end
+
+---@param server_name string
+---@param path string
+---@return string
+local function instruction_file_warning_key(server_name, path)
+    return server_name .. "\0" .. path
+end
+
+---@param server_name string
+---@param path string
+---@param failure_id string
+---@param message string
+local function warn_instruction_file(server_name, path, failure_id, message)
+    local key = instruction_file_warning_key(server_name, path)
+    if instruction_file_warnings[key] == failure_id then
+        return
+    end
+    instruction_file_warnings[key] = failure_id
+    log.warn(message)
+end
+
+---@param server_name string
+---@param path string
+local function clear_instruction_file_warning(server_name, path)
+    instruction_file_warnings[instruction_file_warning_key(server_name, path)] = nil
+end
+
+---@param path string
+---@param server_name string
+---@param requested_limit integer Maximum content bytes needed by this render
+---@return string|nil content
+---@return boolean overflow
+local function read_instruction_file(path, server_name, requested_limit)
+    local uv = vim.uv or vim.loop
+    local stat = uv.fs_stat(path)
+    if not stat or stat.type ~= "file" then
+        warn_instruction_file(
+            server_name,
+            path,
+            "missing",
+            string.format("MCPHub: instruction file for '%s' is missing or not a file: %s", server_name, path)
+        )
+        return nil, false
+    end
+
+    local mtime = stat.mtime or {}
+    local signature = table.concat({ stat.size or -1, mtime.sec or 0, mtime.nsec or 0, stat.ino or 0 }, ":")
+    local cached = instruction_file_cache[path]
+    if cached and cached.signature == signature then
+        if cached.limit >= requested_limit then
+            local content = cached.content:sub(1, requested_limit)
+            local overflow = cached.overflow or #cached.content > requested_limit
+            clear_instruction_file_warning(server_name, path)
+            return content, overflow
+        elseif not cached.overflow then
+            clear_instruction_file_warning(server_name, path)
+            return cached.content, false
+        end
+    end
+
+    local file, open_error = io.open(path, "rb")
+    if not file then
+        warn_instruction_file(
+            server_name,
+            path,
+            "read:" .. signature,
+            string.format(
+                "MCPHub: failed to read instruction file for '%s': %s (%s)",
+                server_name,
+                path,
+                open_error or "unknown error"
+            )
+        )
+        return nil, false
+    end
+    local read_size = math.min(stat.size or (requested_limit + 1), requested_limit + 1)
+    local content, read_error = file:read(read_size)
+    file:close()
+
+    if content == nil then
+        if read_error then
+            warn_instruction_file(
+                server_name,
+                path,
+                "read:" .. signature,
+                string.format(
+                    "MCPHub: failed to read instruction file for '%s': %s (%s)",
+                    server_name,
+                    path,
+                    read_error
+                )
+            )
+            return nil, false
+        end
+        content = ""
+    end
+
+    local overflow = #content > requested_limit
+    if overflow then
+        content = content:sub(1, requested_limit)
+    end
+    instruction_file_cache[path] = {
+        signature = signature,
+        limit = requested_limit,
+        content = content,
+        overflow = overflow,
+    }
+    clear_instruction_file_warning(server_name, path)
+    return content, overflow
+end
+
+---@param byte integer
+---@return integer
+local function utf8_sequence_length(byte)
+    if byte < 0x80 then
+        return 1
+    elseif byte >= 0xC2 and byte <= 0xDF then
+        return 2
+    elseif byte >= 0xE0 and byte <= 0xEF then
+        return 3
+    elseif byte >= 0xF0 and byte <= 0xF4 then
+        return 4
+    end
+    return 1
+end
+
+---@param content string
+---@param max_bytes integer
+---@return integer
+local function utf8_safe_prefix_length(content, max_bytes)
+    local take = math.min(#content, max_bytes)
+    if take == 0 then
+        return 0
+    end
+    local sequence_start = take
+    while sequence_start > 1 do
+        local byte = content:byte(sequence_start)
+        if byte < 0x80 or byte > 0xBF then
+            break
+        end
+        sequence_start = sequence_start - 1
+    end
+    local expected_length = utf8_sequence_length(content:byte(sequence_start))
+    if take - sequence_start + 1 < expected_length then
+        return sequence_start - 1
+    end
+    return take
+end
+
+---@param parts string[]
+---@param remaining integer
+---@return integer
+local function instruction_part_content_budget(parts, remaining)
+    local separator_bytes = #parts > 0 and 2 or 0
+    return math.max(0, remaining - separator_bytes)
+end
+
+---@param parts string[]
+---@param content string
+---@param remaining integer
+---@param source_overflow? boolean
+---@return integer remaining
+---@return boolean truncated
+local function append_instruction_part(parts, content, remaining, source_overflow)
+    if content == "" then
+        return remaining, source_overflow == true
+    end
+    local separator = #parts > 0 and "\n\n" or ""
+    if remaining <= #separator then
+        return 0, true
+    end
+    local available = remaining - #separator
+    local raw_take = math.min(#content, available)
+    local safe_take = utf8_safe_prefix_length(content, raw_take)
+    if safe_take > 0 then
+        table.insert(parts, separator .. content:sub(1, safe_take))
+    end
+    return available - safe_take, source_overflow == true or safe_take < #content
+end
+
+--- Clear cached instruction-file contents and warning deduplication state.
+--- File metadata is checked on every read, so normal file edits invalidate automatically.
+function M.clear_instruction_file_cache()
+    instruction_file_cache = {}
+    instruction_file_warnings = {}
+end
+
