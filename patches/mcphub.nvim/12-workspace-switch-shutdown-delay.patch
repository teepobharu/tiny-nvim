+    -- Different port: defer the switch by shutdown_delay so the previous workspace
+    -- hub stays usable during quick buffer hops. The mcp-hub server was started with
+    -- --shutdown-delay matching this value, so it stays alive over the same window.
+    local delay = tonumber(self.shutdown_delay) or 0
