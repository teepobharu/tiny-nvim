+---@param direction 1|-1
+function MainView:move_active_capability_focus(direction)
+    if not self.active_capability or self.active_capability.type ~= "tool" then
+        return
+    end
+
+    local interactive_lines = self.active_capability.interactive_lines or {}
+    if #interactive_lines == 0 then
+        return
+    end
+
+    local focusable_lines = {}
+    for _, item in ipairs(interactive_lines) do
+        if item.type == "input" or item.type == "submit" then
+            table.insert(focusable_lines, item.line)
+        end
+    end
+
+    if #focusable_lines == 0 then
+        return
+    end
+
+    table.sort(focusable_lines)
+
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local current_line = cursor[1]
+
+    local current_index = nil
+    for i, line in ipairs(focusable_lines) do
+        if line == current_line then
+            current_index = i
+            break
+        end
+    end
+
+    if not current_index then
+        if direction > 0 then
+            vim.api.nvim_win_set_cursor(0, { focusable_lines[1], 2 })
+        else
+            vim.api.nvim_win_set_cursor(0, { focusable_lines[#focusable_lines], 2 })
+        end
+        return
+    end
+
+    local next_index = current_index + direction
+    if next_index < 1 then
+        next_index = #focusable_lines
+    elseif next_index > #focusable_lines then
+        next_index = 1
+    end
+
+    vim.api.nvim_win_set_cursor(0, { focusable_lines[next_index], 2 })
+end
