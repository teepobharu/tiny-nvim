-                self:handle_edit_config()
-            end
-        end,
-        desc = "Edit endpoint config",
-        silent = true,
-    }
     self.keymaps["s"] = {
         action = function()
             local line_type = self:get_line_info(vim.api.nvim_win_get_cursor(0)[1])
@@ -747,9 +737,18 @@ function MainView:setup_active_mode()
             local line_type = self:get_line_info(vim.api.nvim_win_get_cursor(0)[1])
             if line_type == "endpoint" then
                 self:handle_endpoint_yank()
+            else
+                self:handle_context_yank_name()
             end
         end,
-        desc = "Yank endpoint URL",
+        desc = "Yank name",
+        silent = true,
+    }
+    self.keymaps["Y"] = {
+        action = function()
+            self:handle_context_yank_path()
+        end,
+        desc = "Yank path",
         silent = true,
     }
     -- Endpoint and agent keys dispatch by line type here, so cursor movement
@@ -936,6 +935,70 @@ function MainView:handle_endpoint_yank()
     vim.notify("Yanked: " .. ctx.url, vim.log.levels.INFO)
 end
 
+local function get_context_copy_values(line_type, context)
+    if line_type == "endpoint" then
+        return context.url, context.url
+    end
+
+    if line_type == "server" then
+        return context.name, context.name
+    end
+
+    if line_type == "customInstructions" then
+        local server_name = context.server_name
+        if not server_name or server_name == "" then
+            return "Custom Instructions", "Custom Instructions"
+        end
+        return "Custom Instructions", server_name .. "_custom_instructions"
+    end
+
+    if vim.tbl_contains({ "tool", "prompt", "resource", "resourceTemplate" }, line_type) then
+        local def = context.def or {}
+        local name = def.name or def.uri or def.uriTemplate
+        if not name or name == "" then
+            return nil, nil
+        end
+        if not context.server_name or context.server_name == "" then
+            return name, name
+        end
+        return name, context.server_name .. "_" .. name
+    end
+
+    return nil, nil
+end
+
+function MainView:handle_context_yank_name()
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local line_type, context = self:get_line_info(cursor[1])
+    if not line_type or not context then
+        return
+    end
+
+    local name = get_context_copy_values(line_type, context)
+    if not name or name == "" then
+        return
+    end
+
+    vim.fn.setreg("+", name)
+    vim.notify("Yanked name: " .. name, vim.log.levels.INFO)
+end
+
+function MainView:handle_context_yank_path()
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local line_type, context = self:get_line_info(cursor[1])
+    if not line_type or not context then
+        return
+    end
+
+    local _, path = get_context_copy_values(line_type, context)
+    if not path or path == "" then
+        return
+    end
+
+    vim.fn.setreg("+", path)
+    vim.notify("Yanked path: " .. path, vim.log.levels.INFO)
+end
+
