+--- Clear stored OAuth credentials for a server and reconnect it so fresh DCR runs
+--- automatically. Server transitions: disconnected → connecting → unauthorized.
+--- Once the row shows unauthorized, press <l> to open the browser and complete auth.
+--- Requires mcp-hub fork patch 03 (POST /servers/clear-auth).
+--- Falls back to notify on error so callers can use the file-edit path.
+---@param name string Server name
+---@param cb? fun(ok: boolean, err?: string) Optional callback
+function MCPHub:clear_server_auth(name, cb)
+    self:api_request("POST", "servers/clear-auth", {
+        body = { server_name = name },
+        callback = function(response, err)
+            if err then
+                if cb then
+                    cb(false, err)
+                else
+                    vim.notify("[MCPHub] clear-auth failed: " .. tostring(err), vim.log.levels.WARN)
+                end
+                return
+            end
+            -- Immediately reconnect so the server runs fresh DCR and lands on
+            -- "unauthorized" — the user just presses <l> to complete auth.
+            self:api_request("POST", "servers/start", {
+                body = { server_name = name },
+                callback = function(_, start_err)
+                    if start_err then
+                        vim.notify(
+                            "[MCPHub] OAuth cleared for '" .. name .. "'. Reconnect failed: " .. tostring(start_err)
+                                .. ". Toggle the server manually to re-auth.",
+                            vim.log.levels.WARN
+                        )
+                    else
+                        vim.notify(
+                            "[MCPHub] OAuth cleared for '"
+                                .. name
+                                .. "'. Reconnecting… press <l> when row shows 'unauthorized'.",
+                            vim.log.levels.INFO
+                        )
+                    end
+                    if cb then
+                        cb(start_err == nil, start_err)
+                    end
+                end,
+            })
+        end,
+    })
+end
+
