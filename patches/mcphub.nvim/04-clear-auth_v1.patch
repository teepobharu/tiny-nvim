+--- Patch 04: clear stored OAuth credentials for a server row and reconnect.
+--- Calls POST /servers/clear-auth then POST /servers/start (mcp-hub fork patch 03).
+--- Falls back to the file-edit path (utils.mcphub_auth) when the endpoint is absent.
+function MainView:handle_clear_auth(context)
+    if not context or not context.name then
+        return
+    end
+    local name = context.name
+    local ok, auth = pcall(require, "utils.mcphub_auth")
+    if not ok then
+        auth = nil
+    end
+    if State.hub_instance and State.hub_instance.clear_server_auth then
+        State.hub_instance:clear_server_auth(name, function(success, err)
+            if not success then
+                if auth then
+                    local server = State.hub_instance and State.hub_instance:get_server(name)
+                    local url = server and (server.url or server.config and server.config.url)
+                    if url then
+                        auth.clear_notify(url)
+                    else
+                        vim.notify(
+                            "[MCPHub] clear-auth: cannot resolve URL for '" .. name .. "'",
+                            vim.log.levels.WARN
+                        )
+                    end
+                else
+                    vim.notify("[MCPHub] clear-auth failed: " .. tostring(err), vim.log.levels.WARN)
+                end
+            end
+        end)
+    elseif auth then
+        local server = State.hub_instance and State.hub_instance:get_server(name)
+        local url = server and (server.url or server.config and server.config.url)
+        if url then
+            auth.clear_notify(url)
+        else
+            vim.notify("[MCPHub] clear-auth: cannot resolve URL for '" .. name .. "'", vim.log.levels.WARN)
+        end
+    else
+        vim.notify("[MCPHub] clear-auth: hub not connected", vim.log.levels.WARN)
+    end
+end
