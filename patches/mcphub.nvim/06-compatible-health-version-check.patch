# Patch: semver-compatible health version check
# Plugin: ravitemer/mcphub.nvim
# Tested against: 163b3ad [v6.2.0] @2025-07-31
#
# Problem: setup-time version validation accepts compatible mcp-hub patch
# versions (e.g. required 4.2.0, installed/running 4.2.1), but startup
# check_server() used exact string equality against REQUIRED_NODE_VERSION.string.
# A second Neovim instance could therefore treat a compatible existing hub as a
# mismatch and trigger /api/hard-restart, disconnecting other clients.
#
# Fix: use the same validation.validate_version() helper for health response
# versions that setup() already uses for the selected mcp-hub executable.

diff --git i/lua/mcphub/hub.lua w/lua/mcphub/hub.lua
--- i/lua/mcphub/hub.lua
+++ w/lua/mcphub/hub.lua
@@ -5,7 +5,7 @@
 local config_manager = require("mcphub.utils.config_manager")
 local constants = require("mcphub.utils.constants")
 local curl = require("plenary.curl")
-local version = require("mcphub.utils.version")
+local validation = require("mcphub.utils.validation")
 local workspace_utils = require("mcphub.utils.workspace")
 
 local handlers = require("mcphub.utils.handlers")
@@ -587,7 +587,11 @@
             log.debug("Error while get health in check_server")
             callback(false, false, false)
         else
             local is_hub_server = response and response.server_id == "mcp-hub" and response.status == "ok"
-            local is_same_version = response and response.version == version.REQUIRED_NODE_VERSION.string
+            local is_same_version = false
+            if response and response.version then
+                local version_result = validation.validate_version(response.version)
+                is_same_version = version_result.ok == true
+            end
             log.debug(
                 string.format(
                     "Got health response in check_server, is_hub_server (%s), is_same_version (%s) ",
