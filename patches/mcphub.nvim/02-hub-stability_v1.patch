+local tool_regex_cache = {}
+
+---@param files table|nil
+---@return string
+local function format_config_files(files)
+    if type(files) ~= "table" then
+        return "<unknown>"
+    end
+
+    local normalized = {}
+    for _, file in ipairs(files) do
+        table.insert(normalized, tostring(file))
+    end
+    return table.concat(normalized, ", ")
+end
+
+--- Resolve a regex value from server env keys.
+---@param env table<string, any>
+---@param preferred_keys string[]
+---@param suffixes string[]
+---@return string|nil
+local function get_env_regex(env, preferred_keys, suffixes)
+    if type(env) ~= "table" then
+        return nil
+    end
+
+    for _, key in ipairs(preferred_keys) do
+        local value = env[key]
+        if type(value) == "string" and vim.trim(value) ~= "" then
+            return vim.trim(value)
+        end
+    end
+
+    local env_keys = {}
+    for key in pairs(env) do
+        if type(key) == "string" then
+            table.insert(env_keys, key)
+        end
+    end
+    table.sort(env_keys)
+
+    for _, key in ipairs(env_keys) do
+        for _, suffix in ipairs(suffixes) do
+            if key == suffix or key:sub(-#suffix) == suffix then
+                local value = env[key]
+                if type(value) == "string" and vim.trim(value) ~= "" then
+                    return vim.trim(value)
+                end
+            end
+        end
+    end
+
+    return nil
+end
+
+---@param pattern string|nil
+---@return vim.regex|nil
+local function compile_tool_regex(pattern)
+    if type(pattern) ~= "string" or vim.trim(pattern) == "" then
+        return nil
+    end
+
+    local normalized = vim.trim(pattern)
+    local cached = tool_regex_cache[normalized]
+    if cached ~= nil then
+        return cached or nil
+    end
+
+    local ok, regex = pcall(vim.regex, "\\v" .. normalized)
+    if not ok then
+        log.warn("Ignoring invalid tool filter regex", {
+            pattern = normalized,
+            error = regex,
+        })
+        tool_regex_cache[normalized] = false
+        return nil
+    end
+
+    tool_regex_cache[normalized] = regex
+    return regex
+end
+
+---@param server_config table
+---@return { denied: vim.regex|nil, enabled: vim.regex|nil }
+local function get_tool_filter_matchers(server_config)
+    local env = type(server_config.env) == "table" and server_config.env or {}
+    local denied_regex = get_env_regex(
+        env,
+        { "MCPHUB_DENIED_TOOLS_REGEX", "MCPHUB_DISABLED_TOOLS_REGEX", "DENIED_TOOLS_REGEX", "GITLAB_DENIED_TOOLS_REGEX" },
+        { "DENIED_TOOLS_REGEX", "DISABLED_TOOLS_REGEX" }
+    )
+    local enabled_regex = get_env_regex(
+        env,
+        { "MCPHUB_ALLOWED_TOOLS_REGEX", "MCPHUB_ENABLED_TOOLS_REGEX", "ALLOWED_TOOLS_REGEX", "ENABLED_TOOLS_REGEX", "GITLAB_ALLOWED_TOOLS_REGEX" },
+        { "ALLOWED_TOOLS_REGEX", "ENABLED_TOOLS_REGEX" }
+    )
+
+    return {
+        denied = compile_tool_regex(denied_regex),
+        enabled = compile_tool_regex(enabled_regex),
+    }
+end
