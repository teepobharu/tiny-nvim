+-- Jump to next (direction=1) or previous (direction=-1) section_header line.
+function MainView:jump_to_section(direction)
+    local cur = vim.api.nvim_win_get_cursor(0)[1]
+    local headers = {}
+    for _, tracked in ipairs(self.interactive_lines) do
+        if tracked.type == "section_header" then
+            table.insert(headers, tracked.line)
+        end
+    end
+    table.sort(headers)
+    if #headers == 0 then
+        return
+    end
+    local target
+    if direction == 1 then
+        for _, lnum in ipairs(headers) do
+            if lnum > cur then
+                target = lnum
+                break
+            end
+        end
+        if not target then
+            target = headers[1]
+        end
+    else
+        for i = #headers, 1, -1 do
+            if headers[i] < cur then
+                target = headers[i]
+                break
+            end
+        end
+        if not target then
+            target = headers[#headers]
+        end
+    end
+    vim.api.nvim_win_set_cursor(0, { target, 2 })
+end
+
+-- Toggle collapse state for the section under cursor (h=collapse, l=expand).
+-- Returns false for non-foldable nav anchors, falling through to server collapse/expand.
+function MainView:toggle_section_fold(collapse)
+    local cur = vim.api.nvim_win_get_cursor(0)[1]
+    local line_type, ctx = self:get_line_info(cur)
+    if line_type ~= "section_header" then
+        return false
+    end
+    local name = ctx and ctx.name
+    if not name then
+        return false
+    end
+    -- nav-only anchors are not foldable; pass through to server collapse/expand
+    if ctx.hint == "J/K:nav" then
+        return false
+    end
+    if collapse == nil then
+        self.collapsed_sections[name] = not self.collapsed_sections[name]
+    else
+        self.collapsed_sections[name] = collapse
+    end
+    self:draw()
+    -- Restore cursor to the header line (line numbers shift after redraw)
+    vim.schedule(function()
+        for _, tracked in ipairs(self.interactive_lines) do
+            if tracked.type == "section_header" and tracked.context and tracked.context.name == name then
+                local line_count = vim.api.nvim_buf_line_count(self.ui.buffer)
+                vim.api.nvim_win_set_cursor(0, { math.min(tracked.line, line_count), 2 })
+                break
+            end
+        end
+    end)
+    return true
+end
