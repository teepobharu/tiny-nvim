+--- Patch 14: try to recover from a transient SSE disconnect without going through _clean_up().
+--- Probes the existing hub at the same port. If it's still our hub and reachable, reopens SSE.
+--- Otherwise falls through to handle_hub_stopped so the existing UI/error path runs.
+function MCPHub:_attempt_sse_recovery(exit_code)
+    if self.is_shutting_down then
+        return
+    end
+    log.debug("Attempting SSE recovery after exit code " .. tostring(exit_code))
+    -- Reuse check_server; it short-circuits when self:is_ready(), so force a real probe by
+    -- temporarily flipping ready off (we already lost the SSE feed; ready is effectively stale).
+    local was_ready = self.ready
+    self.ready = false
+    self:check_server(function(is_running, is_our_server, _is_same_version)
+        if is_running and is_our_server then
+            log.debug("SSE recovery: hub still alive, reopening SSE without state reset")
+            self.ready = was_ready
+            -- Reconnect; skip if already reconnected by something else
+            if not self.sse_job then
+                self:connect_sse()
+            end
+            return
+        end
+        log.debug("SSE recovery: hub not reachable, falling through to handle_hub_stopped")
+        self:handle_hub_stopped("SSE connection failed with code " .. tostring(exit_code), exit_code)
+    end)
+end
+
