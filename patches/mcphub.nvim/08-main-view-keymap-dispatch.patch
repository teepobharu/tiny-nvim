-            vim.keymap.set("n", "d", function() self:handle_agent_remove() end,
-                vim.tbl_extend("force", kopts, { desc = "Remove agent binding" }))
-            vim.keymap.set("n", "a", function() self:handle_agent_add_lean() end,
-                vim.tbl_extend("force", kopts, { desc = "Add lean endpoint" }))
-            vim.keymap.set("n", "A", function() self:handle_agent_add_flat() end,
-                vim.tbl_extend("force", kopts, { desc = "Add flat endpoint" }))
-            vim.keymap.set("n", "R", function() self:refresh_agent_registry() end,
-                vim.tbl_extend("force", kopts, { desc = "Refresh agent registry" }))
-        end
     end
 end
 
