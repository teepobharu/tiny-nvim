             })
         end
-        -- Scope buffer-local keys to line type; clear patch-05 keys on every cursor move
-        for _, k in ipairs({ "e", "E", "s", "i", "r", "u", "y", "t", "d", "a", "A", "R" }) do
-            pcall(vim.keymap.del, "n", k, { buffer = self.ui.buffer })
-        end
-        local kopts = { buffer = self.ui.buffer, silent = true, nowait = true }
-        if type == "endpoint" then
-            vim.keymap.set("n", "e", function() self:handle_endpoint_inspect() end,
-                vim.tbl_extend("force", kopts, { desc = "Launch inspector" }))
-            vim.keymap.set("n", "E", function() self:handle_edit_config() end,
-                vim.tbl_extend("force", kopts, { desc = "Edit servers.json" }))
-            vim.keymap.set("n", "s", function() self:handle_inspector_stop() end,
-                vim.tbl_extend("force", kopts, { desc = "Stop inspector" }))
-            vim.keymap.set("n", "i", function() self:handle_inspector_edit_config() end,
-                vim.tbl_extend("force", kopts, { desc = "Edit inspector config" }))
-            vim.keymap.set("n", "r", function() self:handle_endpoint_register() end,
-                vim.tbl_extend("force", kopts, { desc = "Register endpoint" }))
-            vim.keymap.set("n", "u", function() self:handle_endpoint_unregister() end,
-                vim.tbl_extend("force", kopts, { desc = "Unregister endpoint" }))
-            vim.keymap.set("n", "y", function() self:handle_endpoint_yank() end,
-                vim.tbl_extend("force", kopts, { desc = "Yank endpoint URL" }))
-        elseif type == "agent_binding" then
-            vim.keymap.set("n", "e", function() self:handle_edit_config() end,
-                vim.tbl_extend("force", kopts, { desc = "Edit agent config" }))
-            vim.keymap.set("n", "t", function() self:handle_agent_toggle() end,
