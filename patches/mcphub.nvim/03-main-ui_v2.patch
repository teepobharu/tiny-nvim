+--- Render one stable hub-state row above the dashboard sections.
+---@return NuiLine[]
+function MainView:render_hub_status()
+    local state = State.server_state.state
+    local state_info = renderer.get_hub_info(state)
+    local suffix = nil
+    local is_starting = State.setup_state == "in_progress"
+        or vim.tbl_contains(
+            { constants.HubState.STARTING, constants.HubState.CONFIGURING, constants.HubState.RESTARTING },
+            state
+        )
+
+    if State.setup_state == "in_progress" then
+        suffix = " - setting up MCPHub"
+    elseif is_starting then
+        local server_count = #(State.server_state.servers or {})
+        if server_count == 0 then
+            suffix = " - waiting for server status"
+        else
+            local tool_count = 0
+            for _, server in ipairs(State.server_state.servers or {}) do
+                if server.status == "connected" then
+                    tool_count = tool_count + #(server.capabilities and server.capabilities.tools or {})
+                end
+            end
+            local tool_suffix = ""
+            if tool_count > 0 then
+                tool_suffix = string.format("; %d tool%s available", tool_count, tool_count == 1 and "" or "s")
+            end
+            suffix = string.format(
+                " - %d server%s reported%s; still connecting",
+                server_count,
+                server_count == 1 and "" or "s",
+                tool_suffix
+            )
+        end
+    end
+
+    local line = NuiLine():append(state_info.icon, state_info.hl):append(state_info.desc, state_info.hl)
+    if suffix then
+        line:append(suffix, Text.highlights.muted)
+    end
+    return { Text.pad_line(line) }
 end
 
