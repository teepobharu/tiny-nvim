 --- Toggle UI visibility
@@ -454,6 +458,73 @@ function UI:show(args)
     -- Draw current view
     self:render()
     self.is_shown = true
+    self:request_startup_server_snapshot()
+end
+
+local STARTUP_STATUS_REFRESH_INTERVAL_MS = 500
+local STARTUP_STATUS_MAX_ATTEMPTS = 30
+
+--- Populate the main view as soon as mcp-hub exposes connection objects.
+--- The hub's health route is available before READY, while the regular server
+--- update only runs after the READY SSE event. Retry briefly because the HTTP
+--- server can accept a request before MCPHub has finished creating its map.
+function UI:request_startup_server_snapshot()
+    self.startup_status_generation = (self.startup_status_generation or 0) + 1
+    self.startup_status_fetching = false
+    self:_request_startup_server_snapshot(self.startup_status_generation, 1)
+end
+
+---@param generation integer
+---@param attempt integer
+function UI:_request_startup_server_snapshot(generation, attempt)
+    if generation ~= self.startup_status_generation
+        or not self.is_shown
+        or not (self.window and vim.api.nvim_win_is_valid(self.window))
+    then
+        return
+    end
+
+    local hub = State.hub_instance
+    if not hub or hub:is_ready() or self.startup_status_fetching then
+        return
+    end
+
+    self.startup_status_fetching = true
+    hub:get_health({
+        callback = function(response)
+            if generation ~= self.startup_status_generation then
+                return
+            end
+
+            self.startup_status_fetching = false
+            if State.hub_instance ~= hub then
+                self:request_startup_server_snapshot()
+                return
+            end
+
+            if response then
+                local servers = response.servers or {}
+                local workspaces = response.workspaces
+                local servers_changed = not vim.deep_equal(State.server_state.servers or {}, servers)
+                local workspaces_changed = workspaces ~= nil
+                    and not vim.deep_equal(State.server_state.workspaces or {}, workspaces)
+                if servers_changed or workspaces_changed then
+                    hub:update_servers(response)
+                end
+            end
+
+            if attempt < STARTUP_STATUS_MAX_ATTEMPTS
+                and self.is_shown
+                and self.window
+                and vim.api.nvim_win_is_valid(self.window)
+                and not hub:is_ready()
+            then
+                vim.defer_fn(function()
+                    self:_request_startup_server_snapshot(generation, attempt + 1)
+                end, STARTUP_STATUS_REFRESH_INTERVAL_MS)
+            end
+        end,
+    })
 end
 
