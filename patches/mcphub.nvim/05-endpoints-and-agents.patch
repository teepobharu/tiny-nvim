+-- ── Endpoint + Agent Registry helpers ────────────────────────────────────────
+
+function MainView:_get_endpoint_context()
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local t, context = self:get_line_info(cursor[1])
+    if t == "endpoint" then
+        return context
+    end
+    return nil
+end
+
+function MainView:_get_agent_context()
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local t, context = self:get_line_info(cursor[1])
+    if t == "agent_binding" then
+        return context
+    end
+    return nil
+end
+
+-- Hide the MCPHub float and edit the file in the underlying window.
+-- The hub itself stays alive (only the floating UI is toggled). Re-show
+-- with :MCPHub (or the user's <leader>ah keymap). Same pattern as ConfigView.
+function MainView:_open_with_back_key(path)
+    self.ui:toggle()
+    vim.cmd("edit " .. vim.fn.fnameescape(path))
+end
+
+function MainView:handle_edit_config()
+    local cursor = vim.api.nvim_win_get_cursor(0)
+    local t, context = self:get_line_info(cursor[1])
+    local path
+    if t == "endpoint" then
+        -- Resolve the active servers.json (workspace-aware) like ConfigView does.
+        local ConfigManager = require("mcphub.utils.config_manager")
+        local files = ConfigManager.get_active_config_files() or {}
+        path = files[1] or vim.fn.expand("~/.config/mcphub/servers.json")
+    elseif t == "agent_binding" then
+        local agents = require("utils.mcphub_agents")
+        path = vim.fn.expand(agents.config_path(context.agent, context.scope))
+    end
+    if not path or path == "" then
+        return
+    end
+    if vim.fn.filereadable(path) == 0 then
+        vim.notify("Config file not found: " .. path, vim.log.levels.WARN)
+        return
+    end
+    self:_open_with_back_key(path)
+end
+
+-- Inspect: launch MCP Inspector and open browser at the endpoint URL.
+function MainView:handle_endpoint_inspect()
+    local ctx = self:_get_endpoint_context()
+    if not ctx then
+        return
+    end
+    require("utils.mcp_inspector").open("sse", ctx.url)
+end
+
+function MainView:handle_inspector_stop()
+    require("utils.mcp_inspector").stop()
+end
+
+function MainView:handle_inspector_edit_config()
+    local path = require("utils.mcp_inspector").config_path()
+    if vim.fn.filereadable(path) == 0 then
+        vim.fn.mkdir(vim.fn.fnamemodify(path, ":h"), "p")
+        vim.fn.writefile({ "{}" }, path)
+    end
+    self:_open_with_back_key(path)
+end
+
+function MainView:handle_endpoint_register()
+    local ctx = self:_get_endpoint_context()
+    if not ctx then
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    agents.register("claude", ctx.binding_name, ctx.url, "user", function(res)
+        if res.ok then
+            vim.notify("Registered " .. ctx.binding_name .. " \xe2\x86\x92 " .. ctx.url, vim.log.levels.INFO)
+        else
+            vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.ERROR)
+        end
+        self:refresh_agent_registry()
+    end)
+end
+
+function MainView:handle_endpoint_unregister()
+    local ctx = self:_get_endpoint_context()
+    if not ctx then
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    agents.unregister("claude", ctx.binding_name, "user", function(res)
+        if res.ok then
+            vim.notify("Unregistered " .. ctx.binding_name, vim.log.levels.INFO)
+        else
+            vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.ERROR)
+        end
+        self:refresh_agent_registry()
+    end)
+end
+
+function MainView:handle_endpoint_yank()
+    local ctx = self:_get_endpoint_context()
+    if not ctx then
+        return
+    end
+    vim.fn.setreg("+", ctx.url)
+    vim.notify("Yanked: " .. ctx.url, vim.log.levels.INFO)
+end
+
+function MainView:handle_agent_add_lean()
+    local ctx = self:_get_agent_context()
+    if not ctx then
+        return
+    end
+    if not ctx.available then
+        vim.notify(ctx.agent .. " binary not found", vim.log.levels.WARN)
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    agents.register(ctx.agent, ctx.binding_lean, "http://localhost:" .. port .. "/mcp-lean", ctx.scope, function(res)
+        if res.ok then
+            vim.notify("Added " .. ctx.binding_lean .. " (" .. ctx.agent .. "/" .. ctx.scope .. ")", vim.log.levels.INFO)
+        else
+            vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.WARN)
+        end
+        self:refresh_agent_registry()
+    end)
+end
+
+function MainView:handle_agent_add_flat()
+    local ctx = self:_get_agent_context()
+    if not ctx then
+        return
+    end
+    if not ctx.available then
+        vim.notify(ctx.agent .. " binary not found", vim.log.levels.WARN)
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    agents.register(ctx.agent, ctx.binding_flat, "http://localhost:" .. port .. "/mcp", ctx.scope, function(res)
+        if res.ok then
+            vim.notify("Added " .. ctx.binding_flat .. " (" .. ctx.agent .. "/" .. ctx.scope .. ")", vim.log.levels.INFO)
+        else
+            vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.WARN)
+        end
+        self:refresh_agent_registry()
+    end)
+end
+
+function MainView:handle_agent_toggle()
+    local ctx = self:_get_agent_context()
+    if not ctx or not ctx.binding then
+        return
+    end
+    if not ctx.available then
+        vim.notify(ctx.agent .. " binary not found", vim.log.levels.WARN)
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    local current_url = ctx.binding.url or ""
+    local new_name, new_url
+    if current_url:find("/mcp%-lean", 1, true) then
+        new_name = ctx.binding_flat
+        new_url = "http://localhost:" .. port .. "/mcp"
+    else
+        new_name = ctx.binding_lean
+        new_url = "http://localhost:" .. port .. "/mcp-lean"
+    end
+    agents.unregister(ctx.agent, ctx.binding.name, ctx.scope, function(_)
+        agents.register(ctx.agent, new_name, new_url, ctx.scope, function(res)
+            if res.ok then
+                vim.notify("Toggled \xe2\x86\x92 " .. new_url, vim.log.levels.INFO)
+            else
+                vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.WARN)
+            end
+            self:refresh_agent_registry()
+        end)
+    end)
+end
+
+function MainView:handle_agent_remove()
+    local ctx = self:_get_agent_context()
+    if not ctx or not ctx.binding then
+        return
+    end
+    if not ctx.available then
+        vim.notify(ctx.agent .. " binary not found", vim.log.levels.WARN)
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    agents.unregister(ctx.agent, ctx.binding.name, ctx.scope, function(res)
+        if res.ok then
+            vim.notify("Removed " .. ctx.binding.name .. " from " .. ctx.agent, vim.log.levels.INFO)
+        else
+            vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.WARN)
+        end
+        self:refresh_agent_registry()
+    end)
+end
+
+function MainView:refresh_agent_registry()
+    State._agent_registry_cache = nil
+    State._agent_registry_fetching = nil
+    self:draw()
+end
+
+-- ── Render: Endpoints panel ───────────────────────────────────────────────────
+
+---@param line_offset number
+---@return NuiLine[]
+function MainView:render_endpoints(line_offset)
+    local cfg = (mcphub_config.ui or {}).endpoints or {}
+    if cfg.enabled == false then
+        return {}
+    end
+
+    local lines = {}
+    local current_line = line_offset
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    local hub_up = State.hub_instance ~= nil and State.hub_instance:is_ready()
+    local server_count = #(State.server_state.servers or {})
+
+    local win_width = vim.api.nvim_win_get_width(0) - 4
+    local header_left = NuiLine():append(" \xef\x8a\x8b Endpoints", Text.highlights.title)
+    local header_right = NuiLine():append("Hub: ", Text.highlights.muted):append("localhost:" .. tostring(port), Text.highlights.success)
+    local pad = math.max(1, win_width - header_left:width() - header_right:width())
+    local header_line = NuiLine():append(header_left):append(string.rep(" ", pad)):append(header_right)
+    table.insert(lines, Text.pad_line(header_line))
+    current_line = current_line + 1
+    table.insert(lines, self:divider())
+    current_line = current_line + 1
+
+    local dot = hub_up and "\xe2\x97\x8f " or "\xe2\x97\x8b "
+    local dot_hl = hub_up and Text.highlights.success or Text.highlights.error
+
+    local reg_cfg = (mcphub_config.ui or {}).agent_registry or {}
+    local first_agent = (reg_cfg.agents or {})[1] or {}
+    local flat_name = first_agent.binding_flat or "mcphub"
+    local lean_name = first_agent.binding_lean or "mcphub-lean"
+
+    local flat_url = "http://localhost:" .. port .. "/mcp"
+    local flat_row = NuiLine()
+        :append("  ", Text.highlights.muted)
+        :append(dot, dot_hl)
+        :append("/mcp      ", Text.highlights.info)
+        :append("flat   ", Text.highlights.muted)
+        :append(tostring(server_count) .. " servers", Text.highlights.muted)
+    table.insert(lines, Text.pad_line(flat_row))
+    current_line = current_line + 1
+    self:track_line(current_line, "endpoint", {
+        url = flat_url,
+        binding_name = flat_name,
+        hint = "e:inspect E:cfg s:stop i:icfg r:reg u:unreg y:yank",
+    })
+
+    local lean_url = "http://localhost:" .. port .. "/mcp-lean"
+    local lean_row = NuiLine()
+        :append("  ", Text.highlights.muted)
+        :append(dot, dot_hl)
+        :append("/mcp-lean ", Text.highlights.info)
+        :append("lean   ", Text.highlights.muted)
+        :append("3 meta-tools", Text.highlights.muted)
+    table.insert(lines, Text.pad_line(lean_row))
+    current_line = current_line + 1
+    self:track_line(current_line, "endpoint", {
+        url = lean_url,
+        binding_name = lean_name,
+        hint = "e:inspect E:cfg s:stop i:icfg r:reg u:unreg y:yank",
+    })
+
+    table.insert(lines, Text.empty_line())
+    return lines
+end
+
+-- ── Render: Agent Registry panel ─────────────────────────────────────────────
+
+function MainView:_ensure_agent_registry(agents_cfg)
+    if State._agent_registry_fetching or State._agent_registry_cache then
+        return
+    end
+    State._agent_registry_fetching = true
+    local mcphub_agents = require("utils.mcphub_agents")
+    local pending = #agents_cfg
+    if pending == 0 then
+        State._agent_registry_cache = {}
+        State._agent_registry_fetching = false
+        return
+    end
+    State._agent_registry_cache = {}
+    for _, agent_cfg in ipairs(agents_cfg) do
+        local name = agent_cfg.name
+        mcphub_agents.list(name, function(res)
+            State._agent_registry_cache[name] = res.bindings or {}
+            pending = pending - 1
+            if pending == 0 then
+                State._agent_registry_fetching = false
+                vim.schedule(function()
+                    self:draw()
+                end)
+            end
+        end)
+    end
+end
+
+---@param line_offset number
+---@return NuiLine[]
+function MainView:render_agent_registry(line_offset)
+    local ui_cfg = mcphub_config.ui or {}
+    local cfg = ui_cfg.agent_registry or {}
+    if cfg.enabled == false then
+        return {}
+    end
+
+    local agents_cfg = cfg.agents or {}
+    local scopes = cfg.scopes or { "user" }
+    self:_ensure_agent_registry(agents_cfg)
+    local cache = State._agent_registry_cache or {}
+
+    local lines = {}
+    local current_line = line_offset
+    local mcphub_agents = require("utils.mcphub_agents")
+
+    local win_width = vim.api.nvim_win_get_width(0) - 4
+    local header_left = NuiLine():append(" \xef\xa0\xa9 CLI Agents", Text.highlights.title)
+    local header_right = NuiLine():append("R:refresh", Text.highlights.muted)
+    local pad = math.max(1, win_width - header_left:width() - header_right:width())
+    local header_line = NuiLine():append(header_left):append(string.rep(" ", pad)):append(header_right)
+    table.insert(lines, Text.pad_line(header_line))
+    current_line = current_line + 1
+    table.insert(lines, self:divider())
+    current_line = current_line + 1
+
+    for _, agent_cfg in ipairs(agents_cfg) do
+        local agent_name = agent_cfg.name
+        local available = mcphub_agents.is_available(agent_name)
+        local bindings = cache[agent_name] or {}
+
+        local binding_map = {}
+        for _, b in ipairs(bindings) do
+            binding_map[b.name] = b
+        end
+
+        for _, scope in ipairs(scopes) do
+            local flat_b = binding_map[agent_cfg.binding_flat]
+            local lean_b = binding_map[agent_cfg.binding_lean]
+            local agent_hl = available and Text.highlights.info or Text.highlights.muted
+            local unavail_suffix = available and "" or " (not found)"
+
+            if lean_b then
+                local sdot = lean_b.status == "connected" and "\xe2\x97\x8f " or "\xe2\x97\x8b "
+                local sdot_hl = lean_b.status == "connected" and Text.highlights.success or Text.highlights.warning
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append(lean_b.name, Text.highlights.info)
+                    :append(" \xe2\x86\x92 /mcp-lean  ", Text.highlights.muted)
+                    :append(sdot, sdot_hl)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                self:track_line(current_line, "agent_binding", {
+                    agent = agent_name, scope = scope, available = available,
+                    binding = lean_b, binding_flat = agent_cfg.binding_flat,
+                    binding_lean = agent_cfg.binding_lean,
+                    hint = "t:toggle d:remove e:cfg",
+                })
+            end
+
+            if flat_b and flat_b.name ~= (lean_b and lean_b.name) then
+                local sdot = flat_b.status == "connected" and "\xe2\x97\x8f " or "\xe2\x97\x8b "
+                local sdot_hl = flat_b.status == "connected" and Text.highlights.success or Text.highlights.warning
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append(flat_b.name, Text.highlights.info)
+                    :append(" \xe2\x86\x92 /mcp       ", Text.highlights.muted)
+                    :append(sdot, sdot_hl)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                self:track_line(current_line, "agent_binding", {
+                    agent = agent_name, scope = scope, available = available,
+                    binding = flat_b, binding_flat = agent_cfg.binding_flat,
+                    binding_lean = agent_cfg.binding_lean,
+                    hint = "t:toggle d:remove e:cfg",
+                })
+            end
+
+            if not lean_b and not flat_b then
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append("(none)", Text.highlights.muted)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                local hint
+                if available then
+                    hint = "a:add-lean A:add-flat e:cfg"
+                else
+                    hint = agent_name .. " not on PATH — e:cfg"
+                end
+                self:track_line(current_line, "agent_binding", {
+                    agent = agent_name, scope = scope, available = available,
+                    binding = nil, binding_flat = agent_cfg.binding_flat,
+                    binding_lean = agent_cfg.binding_lean,
+                    hint = hint,
+                })
+            end
+        end
+    end
+
+    table.insert(lines, Text.empty_line())
+    return lines
+end
