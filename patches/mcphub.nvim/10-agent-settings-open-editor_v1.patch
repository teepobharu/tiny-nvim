+function AgentSettingsView:save_target(path, content)
+    local parent = vim.fn.fnamemodify(path, ":h")
+    if vim.fn.isdirectory(parent) == 0 then
+        vim.fn.mkdir(parent, "p")
+    end
+    local ok, err = pcall(vim.fn.writefile, vim.split(content, "\n", { plain = true }), path)
+    if not ok or err ~= 0 then
+        vim.notify("Could not save: " .. path, vim.log.levels.ERROR)
+        return false
+    end
+    vim.notify("Saved: " .. path, vim.log.levels.INFO)
+    self:refresh()
+    return true
+end
+
+function AgentSettingsView:open_path_in_editor(path)
+    self.ui:toggle()
+    vim.cmd("edit " .. vim.fn.fnameescape(path))
+end
+
+function AgentSettingsView:open_target_in_editor()
+    local target = self:get_target_at_cursor()
+    if not target or not target.path or target.path == "" then
+        return false
+    end
+    local path = vim.fs.normalize(vim.fn.expand(target.path))
+    self:open_path_in_editor(path)
+    return true
+end
