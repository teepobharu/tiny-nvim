+    local scoped = {}
+    for name, cfg in pairs(decoded.mcpServers) do
+        if binding_map[name] then
+            scoped[name] = binding_map[name]
+        else
+            local url = type(cfg) == "table" and cfg.url or nil
+            scoped[name] = {
+                name = name,
+                url = url or "",
+                transport = type(cfg) == "table" and (cfg.type or cfg.transport or "?") or "?",
