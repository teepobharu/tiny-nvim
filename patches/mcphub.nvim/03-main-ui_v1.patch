+local function mcphub_escape_pattern(value)
+    return (tostring(value):gsub("([^%w])", "%%%1"))
+end
+local function mcphub_split_dotpath(matcher)
+    if type(matcher) ~= "string" or not matcher:match("^%.") then return nil end
+    local parts = {}
+    for part in matcher:gsub("^%.", ""):gmatch("[^%.]+") do
+        if part ~= "" then table.insert(parts, part) end
+    end
+    return #parts > 0 and parts or nil
+end
+local function mcphub_find_json_line(bufnr, parts)
+    local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)
+    local start = 1
+    for index, key in ipairs(parts) do
+        local pattern = '^%s*"' .. mcphub_escape_pattern(key) .. '"%s*:'
+        if index == #parts then
+            local best_lnum, best_indent = nil, math.huge
+            for lnum = start, #lines do
+                if lines[lnum]:match(pattern) then
+                    local indent = #(lines[lnum]:match("^(%s*)") or "")
+                    if indent < best_indent then best_indent = indent; best_lnum = lnum end
+                end
+            end
+            return best_lnum
+        end
+        local found = false
+        for lnum = start, #lines do
+            if lines[lnum]:match(pattern) then start = lnum + 1; found = true; break end
+        end
+        if not found then return nil end
+    end
+    return nil
+end
+local function mcphub_find_toml_line(bufnr, parts)
+    local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)
+    if #parts == 1 then
+        local key = mcphub_escape_pattern(parts[1])
+        for lnum, line in ipairs(lines) do
+            if line:match("^%s*%[" .. key .. "%]%s*$") or line:match("^%s*" .. key .. "%s*=") then return lnum end
+        end
+        return nil
+    end
+    local section_parts = {}
+    for i = 1, #parts - 1 do table.insert(section_parts, parts[i]) end
+    local section = mcphub_escape_pattern(table.concat(section_parts, "."))
+    local key = mcphub_escape_pattern(parts[#parts])
+    local in_section = false
+    for lnum, line in ipairs(lines) do
+        if line:match("^%s*%[.+%]%s*$") then
+            in_section = line:match("^%s*%[" .. section .. "%]%s*$") ~= nil
+        elseif in_section and line:match("^%s*" .. key .. "%s*=") then return lnum end
+    end
+    return nil
+end
+local function mcphub_find_yaml_line(bufnr, parts)
+    local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)
+    local key = mcphub_escape_pattern(parts[#parts])
+    for lnum, line in ipairs(lines) do
+        if line:match("^%s*" .. key .. "%s*:") then return lnum end
+    end
+    return nil
+end
+local function mcphub_find_plain_line(bufnr, matcher)
+    local lines = vim.api.nvim_buf_get_lines(bufnr, 0, -1, false)
+    local needle = tostring(matcher):gsub("^%.", "")
+    for lnum, line in ipairs(lines) do
+        if line:find(needle, 1, true) then return lnum end
+    end
+    return nil
+end
+function MainView:_find_config_match_line(bufnr, matcher, path)
+    if type(matcher) == "function" then return matcher(bufnr, path) end
+    if type(matcher) ~= "string" or matcher == "" then return nil end
+    local parts = mcphub_split_dotpath(matcher)
+    if parts then
+        local ext = vim.fn.fnamemodify(path, ":e"):lower()
+        if ext == "json" or ext == "jsonc" then return mcphub_find_json_line(bufnr, parts)
+        elseif ext == "toml" then return mcphub_find_toml_line(bufnr, parts)
+        elseif ext == "yaml" or ext == "yml" then return mcphub_find_yaml_line(bufnr, parts)
+        end
+    end
+    return mcphub_find_plain_line(bufnr, matcher)
+end
