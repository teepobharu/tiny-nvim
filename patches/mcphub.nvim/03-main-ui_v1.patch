+function MainView:_get_scoped_agent_bindings(profile, scope, binding_map)
+    if scope == "global" or profile.preset ~= "claude" then
+        return binding_map
+    end
+
+    local agents = require("utils.mcphub_agents")
+    local path = vim.fn.expand(agents.config_path(profile, scope))
+    if path == "" or vim.fn.filereadable(path) == 0 then
+        return {}
+    end
+
+    local ok, content = pcall(vim.fn.readfile, path)
+    if not ok then
+        return {}
+    end
+
+    local decoded_ok, decoded = utils.json_decode(table.concat(content, "\n"))
+    if not decoded_ok or type(decoded) ~= "table" or type(decoded.mcpServers) ~= "table" then
+        return {}
+    end
