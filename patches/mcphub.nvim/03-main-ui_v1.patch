+function MainView:handle_agent_toggle()
+    local ctx = self:_get_agent_context()
+    if not ctx or not ctx.binding then
+        return
+    end
+    if not ctx.available then
+        vim.notify(ctx.agent_label .. " binary not found", vim.log.levels.WARN)
+        return
+    end
+    local agents = require("utils.mcphub_agents")
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    local current_url = ctx.binding.url or ""
+    local new_name, new_url
+    if current_url:find("/mcp%-lean", 1, true) then
+        new_name = ctx.binding_flat
+        new_url = "http://localhost:" .. port .. "/mcp"
+    else
+        new_name = ctx.binding_lean
+        new_url = "http://localhost:" .. port .. "/mcp-lean"
+    end
+    agents.unregister(ctx.profile or ctx.agent, ctx.binding.name, ctx.scope, function(_)
+        agents.register(ctx.profile or ctx.agent, new_name, new_url, ctx.scope, function(res)
+            if res.ok then
+                vim.notify("Toggled \xe2\x86\x92 " .. new_url, vim.log.levels.INFO)
+            else
+                vim.notify("Failed: " .. (res.stderr or ""), vim.log.levels.WARN)
