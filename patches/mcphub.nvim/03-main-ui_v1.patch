+function MainView:render_endpoints(line_offset)
+    local cfg = (mcphub_config.ui or {}).endpoints or {}
+    if cfg.enabled == false then
+        return {}
+    end
+
+    local lines = {}
+    local current_line = line_offset
+    local port = (State.current_hub and State.current_hub.port) or 37373
+    local hub_up = State.hub_instance ~= nil and State.hub_instance:is_ready()
