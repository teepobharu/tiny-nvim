+    local header_line = NuiLine():append(ag_fold_icon .. " ", Text.highlights.muted):append(header_left):append(string.rep(" ", pad - 2)):append(header_right)
+    table.insert(lines, Text.pad_line(header_line))
+    current_line = current_line + 1
+    self:track_line(current_line, "section_header", { name = "cli_agents", hint = "h:fold l:unfold" })
+    table.insert(lines, self:divider())
+    current_line = current_line + 1
+    if agents_collapsed then
+        return lines
+    end
+
+    for _, agent_cfg in ipairs(agents_cfg) do
+        local function with_alternate_hint(hint)
+            local tokens = {}
+            for _, target in ipairs(agent_cfg.config_alternates or {}) do
+                if target.key then
+                    local lbl = target.label and tostring(target.label):gsub("%s+", "_") or "cfg"
+                    table.insert(tokens, tostring(target.key) .. ":" .. lbl)
+                end
+            end
+            return #tokens > 0 and (hint .. " " .. table.concat(tokens, " ")) or hint
+        end
+        local profile = mcphub_agents.normalize_profile(agent_cfg)
+        local agent_name = profile.label
+        local available = mcphub_agents.is_available(profile)
+        local bindings = cache[profile.id] or {}
+        local scopes = self:_get_agent_scopes(agent_cfg)
+        local binding_flat = agent_cfg.binding_flat or "mcphub"
+        local binding_lean = agent_cfg.binding_lean or "mcphub-lean"
+
+        local binding_map = {}
+        for _, b in ipairs(bindings) do
+            binding_map[b.name] = b
+        end
+
+        for _, scope in ipairs(scopes) do
+            local scoped_bindings = self:_get_scoped_agent_bindings(profile, scope, binding_map)
+            local flat_b = scoped_bindings[binding_flat]
+            local lean_b = scoped_bindings[binding_lean]
+            local agent_hl = available and Text.highlights.info or Text.highlights.muted
+            local unavail_suffix = available and "" or " (not found)"
+
+            if lean_b then
+                local sdot = lean_b.status == "connected" and "\xe2\x97\x8f " or "\xe2\x97\x8b "
+                local sdot_hl = lean_b.status == "connected" and Text.highlights.success or Text.highlights.warning
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append(lean_b.name, Text.highlights.info)
+                    :append(" \xe2\x86\x92 /mcp-lean  ", Text.highlights.muted)
+                    :append(sdot, sdot_hl)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                self:track_line(current_line, "agent_binding", {
+                    agent = profile.id, agent_label = agent_name, profile = profile, scope = scope, available = available,
+                    binding = lean_b, binding_flat = binding_flat,
+                    binding_lean = binding_lean,
+                    config_alternates = agent_cfg.config_alternates,
+                    hint = with_alternate_hint("t:toggle d:remove e:cfg"),
+                })
+            end
+
+            if flat_b and flat_b.name ~= (lean_b and lean_b.name) then
+                local sdot = flat_b.status == "connected" and "\xe2\x97\x8f " or "\xe2\x97\x8b "
+                local sdot_hl = flat_b.status == "connected" and Text.highlights.success or Text.highlights.warning
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append(flat_b.name, Text.highlights.info)
+                    :append(" \xe2\x86\x92 /mcp       ", Text.highlights.muted)
+                    :append(sdot, sdot_hl)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                self:track_line(current_line, "agent_binding", {
+                    agent = profile.id, agent_label = agent_name, profile = profile, scope = scope, available = available,
+                    binding = flat_b, binding_flat = binding_flat,
+                    binding_lean = binding_lean,
+                    config_alternates = agent_cfg.config_alternates,
+                    hint = with_alternate_hint("t:toggle d:remove e:cfg"),
+                })
+            end
+
+            if not lean_b and not flat_b then
+                local row = NuiLine()
+                    :append("  " .. agent_name .. unavail_suffix, agent_hl)
+                    :append("  " .. scope .. "  ", Text.highlights.muted)
+                    :append("(none)", Text.highlights.muted)
+                table.insert(lines, Text.pad_line(row))
+                current_line = current_line + 1
+                local hint
+                if available then
+                    hint = "a:add-lean A:add-flat e:cfg"
+                else
+                    hint = profile.command .. " not on PATH — e:cfg"
+                end
+                self:track_line(current_line, "agent_binding", {
+                    agent = profile.id, agent_label = agent_name, profile = profile, scope = scope, available = available,
+                    binding = nil, binding_flat = binding_flat,
+                    binding_lean = binding_lean,
+                    config_alternates = agent_cfg.config_alternates,
+                    hint = with_alternate_hint(hint),
+                })
+            end
+        end
+    end
+
+    table.insert(lines, Text.empty_line())
+    return lines
+end
