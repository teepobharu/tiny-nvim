+-- ── Render: Agent Registry panel ─────────────────────────────────────────────
+
+function MainView:_ensure_agent_registry(agents_cfg)
+    if State._agent_registry_fetching or State._agent_registry_cache then
+        return
+    end
+    State._agent_registry_fetching = true
+    local mcphub_agents = require("utils.mcphub_agents")
+    local pending = #agents_cfg
+    if pending == 0 then
+        State._agent_registry_cache = {}
+        State._agent_registry_fetching = false
+        return
+    end
+    State._agent_registry_cache = {}
+    for _, agent_cfg in ipairs(agents_cfg) do
+        local profile = mcphub_agents.normalize_profile(agent_cfg)
+        mcphub_agents.list(profile, function(res)
+            State._agent_registry_cache[profile.id] = res.bindings or {}
+            pending = pending - 1
+            if pending == 0 then
+                State._agent_registry_fetching = false
+                vim.schedule(function()
+                    self:draw()
+                end)
+            end
+        end)
+    end
+end
+
+---@param line_offset number
+---@return NuiLine[]
+function MainView:render_agent_registry(line_offset)
+    local ui_cfg = mcphub_config.ui or {}
+    local cfg = ui_cfg.agent_registry or {}
+    if cfg.enabled == false then
+        return {}
+    end
+
+    local agents_cfg = cfg.agents or {}
