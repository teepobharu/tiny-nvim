+
+    local win_width = vim.api.nvim_win_get_width(0) - 4
+    local header_left = NuiLine():append(" \xef\x8a\x8b Endpoints", Text.highlights.title)
+    local header_right = NuiLine():append("Hub: ", Text.highlights.muted):append("localhost:" .. tostring(port), Text.highlights.success)
+    local pad = math.max(1, win_width - header_left:width() - header_right:width())
+    local endpoints_collapsed = self.collapsed_sections["endpoints"]
+    local ep_fold_icon = endpoints_collapsed and Text.icons.triangleRight or Text.icons.triangleDown
+    local header_line = NuiLine():append(ep_fold_icon .. " ", Text.highlights.muted):append(header_left):append(string.rep(" ", pad - 2)):append(header_right)
+    table.insert(lines, Text.pad_line(header_line))
+    current_line = current_line + 1
+    self:track_line(current_line, "section_header", { name = "endpoints", hint = "h:fold l:unfold" })
+    table.insert(lines, self:divider())
