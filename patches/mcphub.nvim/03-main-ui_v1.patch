+        :append("/mcp      ", Text.highlights.info)
+        :append("flat   ", Text.highlights.muted)
+        :append(tostring(server_count) .. " servers", Text.highlights.muted)
+    table.insert(lines, Text.pad_line(flat_row))
+    current_line = current_line + 1
+    self:track_line(current_line, "endpoint", {
+        url = flat_url,
+        binding_name = flat_name,
