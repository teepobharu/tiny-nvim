+          reason: "manual_auth_failed",
+          status: this.status,
+          code,
+          signal,
+        });
+      }
+    });
+    this.authCommand = authCommand;
+    return {
+      authCommand,
+      message: `Started manual authorization for server '${this.name}'`,
+    };
